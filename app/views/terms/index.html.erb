<% content_for :title, "Semester/Quartal" %>

<div class="max-w-4xl mx-auto mt-6 sm:mt-10 w-full mb-16">

  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 sm:mb-8 gap-3 sm:gap-4">
    <div>
      <h1 class="font-bold text-xl sm:text-3xl text-gray-900">Semester/Quartal</h1>
      <p class="text-gray-500 mt-1 text-sm">Datumsbereiche (z.B. HS2026), die Kursen optional zugeordnet werden können.</p>
    </div>
    <%= link_to "Neues Semester/Quartal", new_term_path,
          class: "shrink-0 w-full sm:w-auto text-center bg-primary-600 py-2.5 px-4 shadow-sm text-sm font-bold rounded-lg text-white hover:bg-primary-700 active:bg-primary-800 transition min-h-11" %>
  </div>

  <div class="bg-white shadow-sm ring-1 ring-gray-200 rounded-xl overflow-hidden">
    <% if @terms.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="py-3 px-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Bezeichnung</th>
            <th scope="col" class="py-3 px-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Zeitraum</th>
            <th scope="col" class="py-3 px-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Kurse</th>
            <th scope="col" class="py-3 px-4 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Aktionen</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @terms.each do |term| %>
            <tr class="hover:bg-gray-50 transition duration-150">
              <td class="py-4 px-4">
                <span class="text-sm font-semibold text-gray-900"><%= term.name %></span>
              </td>
              <td class="py-4 px-4 text-sm text-gray-600">
                <%= term.start_date.strftime("%-d. %b %Y") %> &ndash; <%= term.end_date.strftime("%-d. %b %Y") %>
              </td>
              <td class="py-4 px-4 text-sm text-gray-600">
                <%= term.courses.count %>
              </td>
              <td class="py-4 px-4 text-right text-sm font-medium whitespace-nowrap">
                <%= link_to "Bearbeiten", edit_term_path(term),
                      class: "text-primary-600 hover:text-primary-800 font-medium mr-3" %>
                <%= button_to "Löschen", term_path(term), method: :delete,
                      data: { turbo_confirm: "#{term.name} wirklich löschen? Zugeordnete Kurse verlieren die Zuordnung." },
                      form: { class: "inline" },
                      class: "text-red-500 hover:text-red-700 font-medium cursor-pointer bg-transparent border-0 p-0" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="py-14 text-center">
        <p class="font-medium text-gray-700 mb-1">Noch keine Semester/Quartale erfasst.</p>
        <p class="text-sm text-gray-400">Lege einen Datumsbereich an, um ihn später Kursen zuzuordnen.</p>
      </div>
    <% end %>
  </div>

</div>
