<%= form_with(model: term, class: "contents") do |form| %>
  <% if term.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
      <p class="font-semibold mb-1"><%= term.errors.count %> Fehler:</p>
      <ul class="list-disc ml-5 text-sm space-y-0.5">
        <% term.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-6">
    <%= form.label :name, "Bezeichnung", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <p class="text-xs text-gray-400 mb-1.5">z.B. HS2026 (Herbstsemester) oder FS2027 (Frühlingssemester).</p>
    <%= form.text_field :name,
          placeholder: "z.B. HS2026",
          class: ["block w-full rounded-lg border px-3 py-2.5 text-sm shadow-sm focus:outline-none focus:ring-2",
                  term.errors[:name].any? ? "border-red-400 focus:ring-red-400" : "border-gray-300 focus:ring-primary-500"] %>
    <% if term.errors[:name].any? %>
      <p class="mt-1 text-xs text-red-600"><%= term.errors[:name].first %></p>
    <% end %>
  </div>

  <div class="mb-6">
    <%= form.label :kind, "Art", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <p class="text-xs text-gray-400 mb-1.5">Bestimmt die Abfolge – z.B. wird nach diesem Semester automatisch das nächste Semester (nicht Quartal) gesucht.</p>
    <%= form.select :kind,
          [["Semester", "semester"], ["Quartal", "quartal"]],
          { prompt: "Bitte wählen…" },
          class: ["block w-full rounded-lg border px-3 py-2.5 text-sm shadow-sm bg-white focus:outline-none focus:ring-2",
                  term.errors[:kind].any? ? "border-red-400 focus:ring-red-400" : "border-gray-300 focus:ring-primary-500"] %>
    <% if term.errors[:kind].any? %>
      <p class="mt-1 text-xs text-red-600"><%= term.errors[:kind].first %></p>
    <% end %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
    <div>
      <%= form.label :start_date, "Startdatum", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= form.date_field :start_date,
            data: { controller: "datepicker" },
            class: ["block w-full rounded-lg border px-3 py-2.5 text-sm shadow-sm focus:outline-none focus:ring-2",
                    term.errors[:start_date].any? ? "border-red-400 focus:ring-red-400" : "border-gray-300 focus:ring-primary-500"] %>
      <% if term.errors[:start_date].any? %>
        <p class="mt-1 text-xs text-red-600"><%= term.errors[:start_date].first %></p>
      <% end %>
    </div>

    <div>
      <%= form.label :end_date, "Enddatum", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= form.date_field :end_date,
            data: { controller: "datepicker" },
            class: ["block w-full rounded-lg border px-3 py-2.5 text-sm shadow-sm focus:outline-none focus:ring-2",
                    term.errors[:end_date].any? ? "border-red-400 focus:ring-red-400" : "border-gray-300 focus:ring-primary-500"] %>
      <% if term.errors[:end_date].any? %>
        <p class="mt-1 text-xs text-red-600"><%= term.errors[:end_date].first %></p>
      <% end %>
    </div>
  </div>

  <div class="mb-6">
    <%= form.label :priority_registration_date, "Vorlauf für Angemeldete (Datum)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <p class="text-xs text-gray-400 mb-1.5">
      Ab diesem Datum darf sich anmelden, wer im Vorgänger-Kurs bereits angemeldet war. Löst auch die
      automatische Erstellung des Nachfolge-Kurses aus. Leer = Startdatum oben.
    </p>
    <%= form.date_field :priority_registration_date,
          data: { controller: "datepicker" },
          class: ["block w-full rounded-lg border px-3 py-2.5 text-sm shadow-sm focus:outline-none focus:ring-2",
                  term.errors[:priority_registration_date].any? ? "border-red-400 focus:ring-red-400" : "border-gray-300 focus:ring-primary-500"] %>
    <% if term.errors[:priority_registration_date].any? %>
      <p class="mt-1 text-xs text-red-600"><%= term.errors[:priority_registration_date].first %></p>
    <% end %>
  </div>

  <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
    <%= form.submit term.new_record? ? "Semester/Quartal erstellen" : "Änderungen speichern",
          class: "w-full sm:w-auto rounded-lg px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold cursor-pointer transition shadow-sm" %>
    <%= link_to "Abbrechen", terms_path,
          class: "w-full sm:w-auto text-center rounded-lg px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium transition" %>
  </div>
<% end %>
