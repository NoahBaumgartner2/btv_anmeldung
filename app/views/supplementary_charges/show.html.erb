<div class="max-w-md mx-auto mt-6 sm:mt-10 mb-16">

  <div class="text-center mb-6 sm:mb-8">
    <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-amber-100 flex items-center justify-center mx-auto mb-4">
      <svg class="w-7 h-7 sm:w-8 sm:h-8 text-amber-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
      </svg>
    </div>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Zusätzlicher Betrag</h1>
    <p class="text-gray-500 mt-1 text-sm sm:text-base"><%= @charge.participant.first_name %> <%= @charge.participant.last_name %> – <%= @charge.course.title %></p>
  </div>

  <% if flash[:notice] %>
    <div class="mb-5 bg-green-50 border border-green-200 text-green-800 text-sm rounded-xl px-4 py-3"><%= flash[:notice] %></div>
  <% end %>
  <% if flash[:alert] %>
    <div class="mb-5 bg-red-50 border border-red-200 text-red-800 text-sm rounded-xl px-4 py-3"><%= flash[:alert] %></div>
  <% end %>

  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-5">
    <dl class="divide-y divide-gray-100">
      <div class="px-5 py-3 flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-3 text-sm">
        <dt class="font-medium text-gray-500 shrink-0">Beschreibung</dt>
        <dd class="text-gray-900 sm:text-right whitespace-pre-line"><%= @charge.description %></dd>
      </div>
      <div class="px-5 py-4 flex items-baseline justify-between gap-3 bg-amber-50 border-t-2 border-amber-100">
        <dt class="text-sm font-bold text-gray-700 uppercase tracking-wide">Betrag</dt>
        <dd class="text-2xl sm:text-3xl font-extrabold text-amber-700"><%= @charge.amount_display %></dd>
      </div>
    </dl>
  </div>

  <% if @charge.explanation.present? %>
    <div class="bg-gray-50 border border-gray-200 rounded-xl px-5 py-4 mb-6 text-sm text-gray-700 whitespace-pre-line">
      <%= @charge.explanation %>
    </div>
  <% end %>

  <% if @charge.paid? %>
    <div class="flex items-center justify-center gap-2 text-green-700 font-bold text-sm bg-green-50 border border-green-200 rounded-xl py-3">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
      Bezahlt
    </div>
  <% elsif @charge.payable? %>
    <%= link_to checkout_supplementary_charge_path(@charge),
          class: "w-full inline-flex items-center justify-center gap-2 bg-primary-600 hover:bg-primary-700 text-white font-bold py-4 px-6 rounded-xl shadow-sm transition text-base min-h-[52px]",
          data: { turbo: false } do %>
      Jetzt bezahlen &rarr;
    <% end %>
  <% else %>
    <p class="text-center text-sm text-gray-500">Diese Nachforderung ist storniert.</p>
  <% end %>

</div>
