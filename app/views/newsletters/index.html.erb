<div class="max-w-5xl mx-auto mt-8 mb-16 px-4">

  <%= render "admin/shared/section_header" %>

  <%# ── Header ──────────────────────────────────────────────────────────── %>
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
    <div>
      <h2 class="text-xl sm:text-2xl font-bold text-gray-900"><%= t('newsletters.index.title') %></h2>
    </div>
    <div class="grid grid-cols-2 gap-2 w-full sm:w-auto sm:flex">
      <%= link_to t('newsletters.index.subscribers_link'), newsletter_subscribers_path,
            class: "btn btn-secondary border-slate-200 min-h-11 w-full sm:w-auto px-3 whitespace-normal leading-tight text-center" %>
      <%= link_to t('newsletters.index.new_newsletter'), new_newsletter_path,
            class: "btn btn-primary min-h-11 w-full sm:w-auto px-3 whitespace-normal leading-tight text-center" %>
    </div>
  </div>

  <%# ── Stats ────────────────────────────────────────────────────────────── %>
  <div class="grid grid-cols-3 gap-4 mb-8">
    <div class="bg-white border border-slate-200/80 rounded-3xl p-4 text-center shadow-sm">
      <p class="text-2xl font-extrabold text-gray-900"><%= Newsletter.count %></p>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mt-0.5"><%= t('newsletters.index.stat_total') %></p>
    </div>
    <div class="bg-white border border-slate-200/80 rounded-3xl p-4 text-center shadow-sm">
      <p class="text-2xl font-extrabold text-amber-500"><%= Newsletter.drafts.count %></p>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mt-0.5"><%= t('newsletters.index.stat_drafts') %></p>
    </div>
    <div class="bg-white border border-slate-200/80 rounded-3xl p-4 text-center shadow-sm">
      <p class="text-2xl font-extrabold text-green-600"><%= Newsletter.sent.count %></p>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mt-0.5"><%= t('newsletters.index.stat_sent') %></p>
    </div>
  </div>

  <%# ── Entwürfe ──────────────────────────────────────────────────────────── %>
  <% if @drafts.any? %>
    <div class="bg-white border border-slate-200/80 rounded-3xl shadow-sm overflow-hidden mb-6">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="font-bold text-gray-900"><%= t('newsletters.index.section_drafts') %></h2>
      </div>
      <ul class="divide-y divide-gray-50">
        <% @drafts.each do |nl| %>
          <li class="px-5 py-4 flex items-center justify-between gap-4 hover:bg-gray-50 transition">
            <div class="min-w-0">
              <p class="font-bold text-gray-900 truncate"><%= nl.title %></p>
              <p class="text-sm text-gray-500 truncate"><%= t('newsletters.index.draft_subject_prefix') %> <%= nl.subject %></p>
              <p class="text-xs text-gray-400 mt-0.5"><%= t('newsletters.index.draft_edited_prefix') %> <%= nl.updated_at.strftime("%-d. %B %Y, %H:%M") %></p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="hidden sm:inline-flex text-xs font-bold bg-amber-100 text-amber-700 px-2.5 py-1 rounded-full"><%= t('newsletters.index.badge_draft') %></span>
              <%= link_to t('newsletters.index.edit'), edit_newsletter_path(nl),
                    class: "text-sm font-bold text-slate-900 hover:text-slate-900 bg-white border border-slate-200 hover:bg-white border border-slate-200 active:bg-slate-100 px-3 py-1.5 rounded-full transition min-h-11 inline-flex items-center" %>
              <%= button_to t('newsletters.index.delete'), newsletter_path(nl), method: :delete,
                    data: { turbo_confirm: t('newsletters.index.delete_confirm', title: nl.title) },
                    class: "text-sm font-bold text-red-600 bg-red-50 hover:bg-red-100 active:bg-red-200 px-3 py-1.5 rounded-full transition cursor-pointer min-h-11" %>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# ── Versendete Newsletter ───────────────────────────────────────────── %>
  <div class="bg-white border border-slate-200/80 rounded-3xl shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100">
      <h2 class="font-bold text-gray-900"><%= t('newsletters.index.section_sent') %></h2>
    </div>
    <% if @sent.any? %>
      <ul class="divide-y divide-gray-50">
        <% @sent.each do |nl| %>
          <li class="px-5 py-4 flex items-center justify-between gap-4 hover:bg-gray-50 transition">
            <div class="min-w-0">
              <p class="font-bold text-gray-900 truncate"><%= nl.title %></p>
              <p class="text-sm text-gray-500 truncate"><%= t('newsletters.index.draft_subject_prefix') %> <%= nl.subject %></p>
              <p class="text-xs text-gray-400 mt-0.5">
                <%= t('newsletters.index.sent_at_prefix') %> <%= nl.sent_at&.strftime("%-d. %B %Y, %H:%M") %>
                · <%= nl.recipients_count %> <%= t('newsletters.index.recipients_suffix') %>
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-xs font-bold bg-green-100 text-green-700 px-2.5 py-1 rounded-full"><%= t('newsletters.index.badge_sent') %></span>
              <%= link_to t('newsletters.index.preview'), preview_newsletter_path(nl),
                    class: "text-sm font-bold text-gray-600 hover:text-gray-800 bg-gray-100 hover:bg-gray-200 px-3 py-1.5 rounded-full transition" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="py-12 text-center">
        <p class="text-gray-400 text-sm font-medium"><%= t('newsletters.index.empty_sent') %></p>
      </div>
    <% end %>
  </div>

</div>
