    {
      "imports": {
        "@hotwired/turbo":                "<%= asset_path 'turbo.min.js' %>",
        "@hotwired/stimulus":             "<%= asset_path 'stimulus.js' %>",
        "controllers/color_sync_controller":          "<%= asset_path 'controllers/color_sync_controller.js' %>",
        "controllers/field_sorter_controller":        "<%= asset_path 'controllers/field_sorter_controller.js' %>",
        "controllers/confirm_unsubscribe_controller": "<%= asset_path 'controllers/confirm_unsubscribe_controller.js' %>",
        "controllers/export_type_controller":         "<%= asset_path 'controllers/export_type_controller.js' %>",
        "controllers/delete_account_controller":      "<%= asset_path 'controllers/delete_account_controller.js' %>",
        "controllers/modal_controller":               "<%= asset_path 'controllers/modal_controller.js' %>",
        "controllers/course_filter_controller":       "<%= asset_path 'controllers/course_filter_controller.js' %>",
        "controllers/datepicker_controller":          "<%= asset_path 'controllers/datepicker_controller.js' %>",
        "controllers/date_range_controller":          "<%= asset_path 'controllers/date_range_controller.js' %>",
        "controllers/cookie_consent_controller":      "<%= asset_path 'controllers/cookie_consent_controller.js' %>",
        "controllers/registration_mode_controller":   "<%= asset_path 'controllers/registration_mode_controller.js' %>",
        "controllers/password_toggle_controller":     "<%= asset_path 'controllers/password_toggle_controller.js' %>",
        "controllers/scroll_to_error_controller":     "<%= asset_path 'controllers/scroll_to_error_controller.js' %>",
        "controllers/payment_toggle_controller":      "<%= asset_path 'controllers/payment_toggle_controller.js' %>",
        "controllers/trial_check_controller":         "<%= asset_path 'controllers/trial_check_controller.js' %>",
        "controllers/manual_enroll_controller":       "<%= asset_path 'controllers/manual_enroll_controller.js' %>",
        "controllers/trainer_permission_controller":  "<%= asset_path 'controllers/trainer_permission_controller.js' %>",
        "controllers/dropdown_controller":            "<%= asset_path 'controllers/dropdown_controller.js' %>",
        "controllers/mail_toggle_controller":         "<%= asset_path 'controllers/mail_toggle_controller.js' %>",
        "controllers/extra_holidays_controller":      "<%= asset_path 'controllers/extra_holidays_controller.js' %>",
        "controllers/newsletter_opt_in_controller":   "<%= asset_path 'controllers/newsletter_opt_in_controller.js' %>",
        "controllers/discount_toggle_controller":     "<%= asset_path 'controllers/discount_toggle_controller.js' %>",
        "controllers/abo_weekday_filter_controller":  "<%= asset_path 'controllers/abo_weekday_filter_controller.js' %>",
        "controllers/term_mode_controller":           "<%= asset_path 'controllers/term_mode_controller.js' %>",
        "controllers/notification_toggle_controller": "<%= asset_path 'controllers/notification_toggle_controller.js' %>",
        "controllers/notification_preview_controller": "<%= asset_path 'controllers/notification_preview_controller.js' %>",
        "controllers/training_actions_controller":    "<%= asset_path 'controllers/training_actions_controller.js' %>",
        "controllers/auto_submit_controller":         "<%= asset_path 'controllers/auto_submit_controller.js' %>",
        "controllers/active_tab_controller":          "<%= asset_path 'controllers/active_tab_controller.js' %>",
        "controllers/nav_disclosure_controller":       "<%= asset_path 'controllers/nav_disclosure_controller.js' %>",
        "controllers/input_format_controller":        "<%= asset_path 'controllers/input_format_controller.js' %>",
        "controllers/address_split_controller":       "<%= asset_path 'controllers/address_split_controller.js' %>",
        "controllers/tabs_controller":                "<%= asset_path 'controllers/tabs_controller.js' %>",
