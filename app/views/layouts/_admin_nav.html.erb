<%# Sidebar-Eintrag „Admin-Dashboard“ als Aufklapp-Menü: Übersicht + Bereiche der
    Kommandozentrale (AdminNavigation). Offen, solange man im Admin-Bereich ist.
    Locals: link ({ key:, path: } aus nav_sections) %>
<% current_section = admin_section_for_current_page&.first %>
<% on_overview = request.path == link[:path] %>
<div class="nav-disclosure" data-controller="nav-disclosure" <%= "data-open" if current_section || on_overview %>>
  <button type="button" class="nav-item w-full cursor-pointer" aria-expanded="false" aria-controls="admin-subnav"
          data-nav-disclosure-target="button" data-action="nav-disclosure#toggle">
    <%= nav_icon(link[:key]) %><span class="truncate flex-1 text-left"><%= t("nav.#{link[:key]}") %></span>
    <svg class="nav-chevron w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
    </svg>
  </button>
  <div id="admin-subnav" class="nav-sub" data-nav-disclosure-target="panel">
    <ul class="min-h-0 overflow-hidden pl-4">
      <li>
        <%= link_to link[:path], class: "nav-subitem", aria: { current: ("page" if on_overview) } do %>
          <span class="nav-dot bg-slate-400" aria-hidden="true"></span><span class="truncate"><%= t("nav.admin_overview") %></span>
        <% end %>
      </li>
      <% AdminNavigation::SECTIONS.each do |section, items| %>
        <li>
          <%= link_to send(items.first.path), class: "nav-subitem", aria: { current: ("page" if section == current_section) } do %>
            <span class="nav-dot <%= AdminNavigation.tone(section)[:dot] %>" aria-hidden="true"></span>
            <span class="truncate"><%= t("dashboards.admin.sections.#{section}") %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
