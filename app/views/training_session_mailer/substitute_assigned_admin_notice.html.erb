<% primary = @_club&.effective_primary_color || "#2563eb" %>

<table width="100%" cellpadding="0" cellspacing="0" style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;margin-bottom:24px;">
  <tr>
    <td style="padding:16px 20px;">
      <p style="margin:0;font-size:15px;font-weight:600;color:#1e40af;font-family:Arial,Helvetica,sans-serif;">
        Für ein Training wurde eine Ersatztrainer:in eingetragen.
      </p>
    </td>
  </tr>
</table>

<p style="margin:0 0 20px 0;font-size:15px;color:#374151;font-family:Arial,Helvetica,sans-serif;">
  Hallo <%= greeting_name(@admin_user) %>,<br><br>
  zur Info: für das folgende Training wurde eine Ersatztrainer:in eingetragen.
</p>

<table width="100%" cellpadding="0" cellspacing="0" style="background:#f9fafb;border-radius:8px;margin-bottom:24px;">
  <tr>
    <td style="padding:16px 20px;">
      <p style="margin:0 0 6px 0;font-size:14px;color:#6b7280;text-transform:uppercase;letter-spacing:0.05em;font-family:Arial,Helvetica,sans-serif;">Kurs</p>
      <p style="margin:0 0 12px 0;font-size:16px;font-weight:600;color:#111827;font-family:Arial,Helvetica,sans-serif;"><%= @course.title %></p>
      <p style="margin:0 0 6px 0;font-size:14px;color:#6b7280;text-transform:uppercase;letter-spacing:0.05em;font-family:Arial,Helvetica,sans-serif;">Datum &amp; Zeit</p>
      <p style="margin:0 0 12px 0;font-size:16px;color:#111827;font-family:Arial,Helvetica,sans-serif;">
        <%= format_session_range(@training_session.start_time, @training_session.end_time) %>
      </p>
      <p style="margin:0 0 6px 0;font-size:14px;color:#6b7280;text-transform:uppercase;letter-spacing:0.05em;font-family:Arial,Helvetica,sans-serif;">Ersatztrainer:in</p>
      <p style="margin:0 0 12px 0;font-size:16px;font-weight:600;color:#111827;font-family:Arial,Helvetica,sans-serif;"><%= @substitute_trainer.full_name %></p>
      <% if @training_session.substitute_reason.present? %>
        <p style="margin:0 0 6px 0;font-size:14px;color:#6b7280;text-transform:uppercase;letter-spacing:0.05em;font-family:Arial,Helvetica,sans-serif;">Grund</p>
        <p style="margin:0;font-size:16px;color:#111827;font-family:Arial,Helvetica,sans-serif;white-space:pre-line;"><%= @training_session.substitute_reason %></p>
      <% end %>
    </td>
  </tr>
</table>

<p style="margin:0 0 24px 0;font-size:15px;color:#374151;font-family:Arial,Helvetica,sans-serif;">
  Diese Benachrichtigung kannst du unter "Meine Benachrichtigungen" für dich persönlich abschalten.
</p>

<table cellpadding="0" cellspacing="0" style="margin-bottom:32px;">
  <tr>
    <td style="background:<%= primary %>;border-radius:8px;padding:12px 24px;">
      <a href="<%= @training_session_url %>" style="color:#ffffff;text-decoration:none;font-size:15px;font-weight:600;font-family:Arial,Helvetica,sans-serif;">Training ansehen</a>
    </td>
  </tr>
</table>
