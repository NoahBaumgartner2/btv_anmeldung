<div class="max-w-3xl mx-auto w-full px-4 mt-6 sm:mt-8 mb-16">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 sm:mb-8 gap-4">
    <div>
      <span class="text-red-600 font-bold text-sm tracking-wider uppercase mb-1 block"><%= t("course_categories.index.header_label") %></span>
      <h1 class="font-extrabold text-2xl sm:text-3xl text-gray-900"><%= t("course_categories.index.title") %></h1>
    </div>
    <%= link_to t("course_categories.index.back_to_dashboard"), dashboards_admin_path,
          class: "bg-white border border-gray-300 py-2 px-4 rounded-lg shadow-sm text-sm font-bold text-gray-700 hover:bg-gray-50 transition" %>
  </div>

  <p class="text-sm text-gray-600 mb-6 max-w-2xl"><%= t("course_categories.index.intro") %></p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <% @categories.each do |cat| %>
      <%# Kein glass/backdrop-filter auf der Kachel: würde das fixed-Modal einsperren. %>
      <div data-controller="modal" class="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden flex flex-col">
        <%= form_with model: cat[:record], url: update_image_course_category_path(cat[:record]), method: :patch,
              multipart: true, data: { controller: "auto-submit" } do |f| %>
          <label class="group relative block aspect-[8/5] bg-gray-100 cursor-pointer focus-within:ring-2 focus-within:ring-inset focus-within:ring-primary-500">
            <% if cat[:record].image.attached? %>
              <img src="<%= cat[:record].image_url %>" alt="" class="absolute inset-0 w-full h-full object-cover">
            <% else %>
              <span class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-sm font-medium text-gray-500 border-b border-dashed border-gray-300">
                <svg class="w-8 h-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21zm11.25-12.75h.008v.008H15V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/>
                </svg>
              </span>
            <% end %>
            <span class="absolute bottom-3 right-3 rounded-full bg-white/90 px-3 py-1.5 text-xs font-semibold text-gray-800 shadow-sm group-hover:bg-white transition-colors">
              <%= cat[:record].image.attached? ? t("course_categories.index.change_image") : t("course_categories.index.add_image") %>
            </span>
            <%= f.file_field :image, accept: "image/png,image/jpeg,image/webp", class: "sr-only",
                  data: { action: "change->auto-submit#submit" } %>
          </label>
        <% end %>

        <div class="p-4 flex-1 flex flex-col gap-3">
          <div class="min-w-0">
            <p class="font-bold text-gray-900 truncate"><%= cat[:name] %></p>
            <p class="text-xs text-gray-500">
              <%= t("course_categories.index.summary", courses: cat[:course_count], recipients: cat[:recipient_count]) %>
              · <%= t("course_categories.index.own_photos", count: cat[:own_photos], total: cat[:course_count]) %>
            </p>
          </div>
          <div class="mt-auto flex items-center justify-between gap-3">
            <% if cat[:record].image.attached? %>
              <%= button_to t("course_categories.index.remove_image"), destroy_image_course_category_path(cat[:record]), method: :delete,
                    class: "text-xs font-semibold text-red-600 hover:text-red-800 cursor-pointer",
                    data: { turbo_confirm: t("course_categories.index.remove_confirm", category: cat[:name]) } %>
            <% else %>
              <span></span>
            <% end %>
            <button type="button" data-action="click->modal#open" class="btn btn-secondary border-gray-200">
              <%= t("course_categories.index.compose_button") %>
            </button>
          </div>
        </div>

        <div data-modal-target="dialog"
             data-action="click->modal#backdropClose"
             class="hidden fixed inset-0 z-50 items-center justify-center bg-gray-900/60 backdrop-blur-sm p-4">
          <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6 text-left">
            <h3 class="text-lg font-extrabold text-gray-900 mb-5"><%= t("course_categories.index.modal_title", category: cat[:name]) %></h3>
            <%= form_with url: send_email_course_categories_path, method: :post, data: { turbo: false }, class: "space-y-4" do %>
              <%= hidden_field_tag :category, cat[:name] %>
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-1.5 uppercase tracking-wide"><%= t("course_categories.index.subject_label") %></label>
                <input type="text" name="subject" required
                       class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500">
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-1.5 uppercase tracking-wide"><%= t("course_categories.index.body_label") %></label>
                <textarea name="body" rows="5" required
                          class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 resize-none"></textarea>
              </div>
              <div class="flex gap-3 pt-2">
                <button type="submit"
                        class="flex-1 bg-primary-600 hover:bg-primary-700 active:bg-primary-800 text-white font-bold py-2.5 px-4 rounded-xl text-sm transition cursor-pointer min-h-11">
                  <%= t("course_categories.index.submit") %>
                </button>
                <button type="button" data-action="click->modal#close"
                        class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-2.5 px-4 rounded-xl text-sm transition cursor-pointer min-h-11">
                  <%= t("course_categories.index.cancel") %>
                </button>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
