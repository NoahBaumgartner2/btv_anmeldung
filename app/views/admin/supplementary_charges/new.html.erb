<div class="max-w-3xl mx-auto w-full">
  <div class="mb-6">
    <h1 class="font-bold text-2xl sm:text-3xl text-gray-900">Nachforderung erstellen</h1>
    <p class="text-gray-500 text-sm mt-1">
      Betrag, Kurs und Begründung gelten für ALLE unten ausgewählten Personen -
      pro Person entsteht eine eigene Nachforderung samt individueller E-Mail.
    </p>
  </div>

  <% if flash[:alert] %>
    <div class="mb-5 bg-red-50 border border-red-200 text-red-800 text-sm rounded-xl px-4 py-3"><%= flash[:alert] %></div>
  <% end %>

  <%= form_with url: admin_supplementary_charges_path, method: :post, class: "space-y-6" do %>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 space-y-4">
      <h2 class="font-bold text-gray-800">Angaben</h2>

      <div>
        <label class="block text-xs font-bold text-gray-700 mb-1.5 uppercase tracking-wide">Betrag (CHF)</label>
        <input type="text" name="amount" value="<%= params[:amount] %>" required
               placeholder="30.00"
               class="block w-full sm:w-48 rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500">
      </div>

      <%
        courses_data = @courses.map do |c|
          { id: c.id, title: c.title, category: c.category,
            termId: c.term_id, termName: c.term&.name, termStart: c.term&.start_date&.iso8601 }
        end
        registrations_data = CourseRegistration.where.not(status: "storniert")
          .includes(participant: :user)
          .map do |r|
            p = r.participant
            { courseId: r.course_id, participantId: p.id,
              name: "#{p.first_name} #{p.last_name}", email: p.user&.email }
          end
      %>
      <div data-controller="course-picker"
           data-course-picker-courses-value="<%= courses_data.to_json %>"
           data-course-picker-registrations-value="<%= registrations_data.to_json %>"
           data-course-picker-selected-course-id-value="<%= params[:course_id] %>">
        <label class="block text-xs font-bold text-gray-700 mb-1.5 uppercase tracking-wide">Kurs</label>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <select data-course-picker-target="termSelect" data-action="change->course-picker#onTermChange"
                  class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white"></select>
          <select data-course-picker-target="categorySelect" data-action="change->course-picker#onCategoryChange"
                  class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white"></select>
          <select name="course_id" required data-course-picker-target="courseSelect" data-action="change->course-picker#onCourseChange"
                  class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white"></select>
        </div>
        <p class="text-xs text-gray-400 mt-1">Zuerst Zeitraum, dann Kategorie eingrenzen - der Kurs wird entsprechend gefiltert.</p>

        <div class="mt-5 pt-5 border-t border-gray-100">
          <label class="block text-xs font-bold text-gray-700 mb-1.5 uppercase tracking-wide">Personen (Teilnehmerliste des gewählten Kurses)</label>
          <ul data-course-picker-target="participantsList"
              class="divide-y divide-gray-100 border border-gray-100 rounded-lg overflow-hidden"></ul>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-gray-700 mb-1.5 uppercase tracking-wide">Beschreibung (erscheint auf der Quittung)</label>
        <input type="text" name="description" value="<%= params[:description] %>" required
               placeholder="z.B. Korrektur fälschlich angewendeter Rabatt Q4 2026"
               class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500">
      </div>

      <div>
        <label class="block text-xs font-bold text-gray-700 mb-1.5 uppercase tracking-wide">Erklärtext für die E-Mail an die Eltern <span class="font-normal text-gray-400">(optional, aber empfohlen)</span></label>
        <textarea name="explanation" rows="4"
                  placeholder="z.B. Bei der Anmeldung wurde fälschlicherweise ein Geschwisterrabatt angewendet, der nicht zutrifft. Wir bitten dich, die Differenz von CHF 30.- nachträglich zu begleichen."
                  class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 resize-none"><%= params[:explanation] %></textarea>
      </div>
    </div>

    <div class="flex gap-3">
      <button type="submit"
              class="flex-1 bg-primary-600 hover:bg-primary-700 active:bg-primary-800 text-white font-bold py-3 px-4 rounded-xl text-sm transition cursor-pointer min-h-11"
              data-turbo-confirm="Nachforderung(en) erstellen und Mails versenden?">
        Nachforderung(en) erstellen &amp; Mails versenden
      </button>
      <%= link_to "Abbrechen", admin_supplementary_charges_path,
            class: "flex-1 text-center bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-3 px-4 rounded-xl text-sm transition min-h-11" %>
    </div>
  <% end %>
</div>
