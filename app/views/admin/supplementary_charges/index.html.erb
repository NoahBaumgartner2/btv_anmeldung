<div class="max-w-5xl mx-auto w-full">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <h1 class="font-bold text-2xl sm:text-3xl text-gray-900">Nachforderungen</h1>
    <%= link_to "+ Neue Nachforderung", new_admin_supplementary_charge_path,
          class: "bg-primary-600 hover:bg-primary-700 text-white font-bold py-2.5 px-4 rounded-lg text-sm transition" %>
  </div>

  <% if flash[:notice] %>
    <div class="mb-5 bg-green-50 border border-green-200 text-green-800 text-sm rounded-xl px-4 py-3"><%= flash[:notice] %></div>
  <% end %>

  <div class="bg-white shadow-sm ring-1 ring-gray-200 rounded-lg overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="py-3 px-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Teilnehmer</th>
          <th class="py-3 px-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Kurs</th>
          <th class="py-3 px-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Beschreibung</th>
          <th class="py-3 px-4 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Betrag</th>
          <th class="py-3 px-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="py-3 px-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Erstellt</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 bg-white">
        <% if @charges.any? %>
          <% @charges.each do |charge| %>
            <tr class="hover:bg-gray-50 transition">
              <td class="py-3.5 px-4 text-sm font-semibold text-gray-900 whitespace-nowrap">
                <%= charge.participant.first_name %> <%= charge.participant.last_name %>
              </td>
              <td class="py-3.5 px-4 text-sm text-gray-600"><%= charge.course.title %></td>
              <td class="py-3.5 px-4 text-sm text-gray-600"><%= truncate(charge.description, length: 60) %></td>
              <td class="py-3.5 px-4 text-sm text-gray-900 font-bold text-right whitespace-nowrap"><%= charge.amount_display %></td>
              <td class="py-3.5 px-4 text-sm">
                <% status_color = { "offen" => "bg-yellow-100 text-yellow-700", "bezahlt" => "bg-green-100 text-green-800", "storniert" => "bg-gray-100 text-gray-500" }[charge.status] %>
                <span class="px-2 py-1 rounded-full text-xs font-medium <%= status_color %>"><%= charge.status %></span>
              </td>
              <td class="py-3.5 px-4 text-sm text-gray-500 whitespace-nowrap"><%= charge.created_at.strftime("%d.%m.%Y") %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="py-12 text-center text-sm text-gray-500">Noch keine Nachforderungen erstellt.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
