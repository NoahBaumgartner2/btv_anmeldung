<div class="max-w-3xl mx-auto mt-8 sm:mt-10 mb-16 px-4">

  <%= render "admin/shared/section_header", active: :settings_features, subtitle: t("admin.settings.subtitle") %>

  <section>
    <h2 class="text-lg font-bold text-gray-900 mb-1"><%= t("admin.settings.features.title") %></h2>
    <p class="text-sm text-gray-500 mb-4"><%= t("admin.settings.features.desc") %></p>

    <% if @feature_setting.errors.any? %>
      <div class="mb-4 rounded-2xl bg-red-50 border border-red-100 px-4 py-3 text-sm text-red-700" role="alert">
        <% @feature_setting.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
      </div>
    <% end %>

    <%# Formular komplett aus SettingsCatalog: Schalter speichern sofort, Zahlen über „Speichern“. %>
    <%= form_with model: @feature_setting, url: admin_feature_setting_path, method: :patch,
          data: { controller: "auto-submit" }, class: "space-y-6" do |f| %>
      <% SettingsCatalog.groups.each do |group, entries| %>
        <div>
          <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2 px-1"><%= t("admin.settings.features.groups.#{group}") %></h3>
          <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm divide-y divide-gray-100">
            <% entries.each do |entry| %>
              <%= render "admin/settings/setting_field", f: f, entry: entry, value: @feature_setting.value(entry.key) %>
            <% end %>
          </div>
        </div>
      <% end %>
      <% unless SettingsCatalog::ENTRIES.all?(&:boolean?) %>
        <div class="flex justify-end">
          <%= f.submit t("admin.settings.features.save"), class: "btn btn-primary" %>
        </div>
      <% end %>
    <% end %>
  </section>

</div>
