<div class="max-w-3xl mx-auto mt-8 sm:mt-10 mb-16 px-4">

  <%= render "admin/shared/section_header", active: :settings_payments, subtitle: t("admin.settings.subtitle") %>

  <section class="mb-10">
    <h2 class="text-lg font-bold text-gray-900 mb-1"><%= t("admin.settings.payments.title") %></h2>
    <p class="text-sm text-gray-500 mb-4"><%= t("admin.settings.payments.desc") %></p>
    <%= render "admin/payment_settings/form" %>
  </section>

  <section>
    <h2 class="text-lg font-bold text-gray-900 mb-4"><%= t("admin.settings.payments.actions_title") %></h2>
    <%= render "admin/payment_settings/actions" %>
  </section>

</div>
