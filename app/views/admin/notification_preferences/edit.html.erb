<div class="max-w-3xl mx-auto mt-10 mb-16 px-4">

  <%# ── Header ────────────────────────────────────────────────────────────── %>
  <div class="mb-8">
    <%= link_to (current_user.admin? ? "← Kommandozentrale" : "← #{t('nav.my_courses')}"),
          current_user.admin? ? dashboards_admin_path : dashboards_trainer_path,
          class: "text-sm font-semibold text-gray-500 hover:text-gray-800 transition" %>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mt-2">Meine Benachrichtigungen</h1>
    <p class="text-gray-500 mt-1 text-sm">Wähle, welche Benachrichtigungen du persönlich erhalten möchtest. Jeder Eintrag zeigt, in welcher Rolle er dich betrifft.</p>
  </div>

  <%= form_with url: admin_notification_preferences_path, method: :patch do %>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
      <ul class="divide-y divide-gray-100">
        <% rows = [
          [ "cancel_notice",          "Abmeldung von Kurs",       "Wenn ein Teilnehmer sich vom Kurs abmeldet (Kurs dem du als Trainer zugewiesen bist)", "trainer" ],
          [ "session_unsubscription", "Abmeldung von Training",   "Wenn ein Teilnehmer sich von einer einzelnen Trainingseinheit abmeldet", "trainer" ],
          [ "attendance_reminder",    "Anwesenheitserinnerung",   "Wenn Anwesenheiten nach dem Training noch nicht erfasst wurden", "trainer" ],
        ]
        # Nur Admins bekommen diese Mails (siehe TrainingSessionsController#cancel und
        # CourseRegistrationsController#trainer_cancel) – für reine Trainer wären die
        # Schalter wirkungslos und nur verwirrend.
        if current_user.admin?
          rows << [ "training_cancelled", "Training abgesagt", "Wenn ein Trainer ein einzelnes Training absagt", "admin" ]
          rows << [ "refund_done", "Rückerstattung erfolgt", "Wenn ein Trainer einen Teilnehmer abmeldet und die Rückerstattung automatisch erfolgt ist", "admin" ]
          rows << [ "refund_failed", "Rückerstattung fehlgeschlagen", "Wenn eine automatische Rückerstattung technisch fehlgeschlagen ist", "admin" ]
          rows << [ "substitute_assigned_admin", "Ersatztrainer eingetragen", "Wenn ein Trainer für ein Training eine:n Ersatztrainer:in einträgt (mit Grund)", "admin" ]
          rows << [ "participant_profile_updated", "Teilnehmerprofil geändert", "Wenn ein angemeldeter Teilnehmer sein Profil ändert (z.B. Adresse, Telefonnummer) - nur bei Kursen mit aktivierter Option", "admin" ]
          rows << [ "trainer_profile_updated", "Trainerprofil geändert", "Wenn ein Trainer sein eigenes Profil ändert (z.B. Adresse, Telefonnummer, IBAN)", "admin" ]
        end
        rows.each do |type, name, description, role| %>
          <% mandatory = User::MANDATORY_NOTIFICATION_TYPES.include?(type) %>
          <% enabled = current_user.admin_notification_enabled?(type) %>
          <% role_label = role == "admin" ? "Als Admin" : "Als Trainer" %>
          <% role_classes = role == "admin" ? "bg-purple-50 text-purple-700" : "bg-blue-50 text-blue-700" %>
          <li class="flex items-center gap-4 px-6 py-4">
            <div class="shrink-0 w-9 h-9 rounded-xl bg-indigo-50 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <p class="text-sm font-semibold text-gray-800"><%= name %></p>
                <span class="inline-flex items-center rounded-full text-xs font-bold px-2 py-0.5 <%= role_classes %>"><%= role_label %></span>
              </div>
              <p class="text-xs text-gray-400 mt-0.5"><%= description %></p>
              <% if mandatory %>
                <p class="text-xs text-gray-500 mt-1"><%= t("admin.notification_preferences.attendance_reminder_mandatory_hint") %></p>
              <% end %>
            </div>
            <% if mandatory %>
              <span class="shrink-0 inline-flex items-center gap-1.5 rounded-full bg-green-50 text-green-700 text-xs font-bold px-3 py-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                <%= t("admin.notification_preferences.mandatory_badge") %>
              </span>
            <% else %>
              <label class="shrink-0 relative inline-flex items-center cursor-pointer">
                <input type="checkbox"
                       name="preferences[<%= type %>]"
                       value="1"
                       <%= "checked" if enabled %>
                       class="sr-only peer">
                <span class="block h-6 w-11 rounded-full bg-gray-200 transition-colors duration-200 peer-checked:bg-green-500 peer-focus:ring-2 peer-focus:ring-indigo-500 peer-focus:ring-offset-2 after:content-[''] after:absolute after:top-1 after:left-1 after:h-4 after:w-4 after:rounded-full after:bg-white after:shadow after:transition-transform after:duration-200 peer-checked:after:translate-x-5"></span>
              </label>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="mt-6">
      <%= submit_tag "Speichern",
            class: "w-full sm:w-auto bg-primary-600 hover:bg-primary-700 active:bg-primary-800 text-white font-bold py-2.5 px-6 rounded-xl shadow-sm text-sm transition cursor-pointer min-h-11" %>
    </div>
  <% end %>

</div>
