<%# Mail-Vorschau wie in einem Mailprogramm: Kopf (Betreff, Von, An, Datum) und
    darunter die echte Mail mit ihren Inline-Styles. Eigene CSP im Controller. %>
<% from = @message[:from].to_s.presence || @message.from.to_a.join(", ") %>
<% sender = @message[:from]&.display_names&.first.presence || @message.from.to_a.first.to_s %>
<% primary = ClubSetting.current.effective_primary_color %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <base target="_blank">
  <style>
    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; color: #111827; background: #ffffff; }
    .mail-head { padding: 20px 24px 16px; border-bottom: 1px solid #e5e7eb; }
    .mail-subject { margin: 0 0 14px; font-size: 20px; line-height: 1.3; font-weight: 700; }
    .mail-meta { display: flex; align-items: center; gap: 12px; }
    .mail-avatar { flex: none; width: 40px; height: 40px; border-radius: 9999px; color: #fff; font-weight: 700; font-size: 16px; display: flex; align-items: center; justify-content: center; }
    .mail-from { font-size: 14px; font-weight: 600; overflow-wrap: anywhere; }
    .mail-to, .mail-date { font-size: 13px; color: #6b7280; overflow-wrap: anywhere; }
    .mail-date { margin-left: auto; white-space: nowrap; align-self: flex-start; }
    .mail-sample { margin: 12px 0 0; font-size: 12px; color: #92400e; background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 6px 10px; }
    @media (max-width: 480px) { .mail-meta { flex-wrap: wrap; } .mail-date { margin-left: 52px; } }
  </style>
</head>
<body>
  <header class="mail-head">
    <h1 class="mail-subject"><%= @message.subject %></h1>
    <div class="mail-meta">
      <div class="mail-avatar" style="background: <%= primary %>;" aria-hidden="true"><%= sender.to_s.strip.first.to_s.upcase %></div>
      <div>
        <div class="mail-from"><%= from %></div>
        <div class="mail-to"><%= t("admin.notifications.preview.to", recipients: @message.to.to_a.join(", ")) %></div>
      </div>
      <div class="mail-date"><%= l(Time.current, format: :short) %></div>
    </div>
    <p class="mail-sample"><%= t("admin.notifications.preview.sample_hint") %></p>
  </header>
  <main style="<%= @mail_body_style %>"><%= @mail_body_html.html_safe %></main>
</body>
</html>
