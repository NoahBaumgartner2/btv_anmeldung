<%# Link-Zeile einer Admin-Seite. Locals: item (AdminNavigation::Item), tone (Farbschema des Bereichs), badge (Zahl, nur > 0 sichtbar) %>
<% show_badge = badge.to_i.positive? %>
<%= link_to send(item.path),
      class: "group flex items-center gap-3.5 px-4 py-3.5 #{tone[:row]} transition min-h-12" do %>
  <div class="shrink-0 w-9 h-9 rounded-xl <%= tone[:box] %> flex items-center justify-center transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 <%= tone[:icon] %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="<%= item.icon %>"/>
    </svg>
  </div>
  <div class="min-w-0">
    <p class="text-sm font-bold text-gray-800 <%= tone[:title] %> transition"><%= t("dashboards.admin.links.#{item.key}") %></p>
    <p class="text-xs text-gray-400 truncate"><%= t("dashboards.admin.links.#{item.key}_desc") %></p>
  </div>
  <% if show_badge %>
    <span class="ml-auto shrink-0 text-xs font-bold <%= tone[:badge] %> px-2 py-0.5 rounded-full"><%= badge %></span>
  <% end %>
  <svg xmlns="http://www.w3.org/2000/svg" class="<%= show_badge ? 'ml-2' : 'ml-auto' %> h-4 w-4 text-gray-300 <%= tone[:chevron] %> shrink-0 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
  </svg>
<% end %>
