<% content_for :title, t("participants.my_trainings.title") %>

<div class="max-w-5xl mx-auto w-full px-4 sm:px-6 mt-6 sm:mt-10 mb-16">
  <h1 class="font-extrabold text-2xl sm:text-4xl text-gray-900 tracking-tight"><%= t("participants.my_trainings.title") %></h1>
  <p class="text-gray-500 mt-1 sm:mt-2 text-sm sm:text-lg mb-6 sm:mb-8"><%= t("participants.my_trainings.subtitle") %></p>

  <%= render "participants/profile_tabs", active: :trainings %>

  <% if @participants.any? %>
    <div class="space-y-6 sm:space-y-10">
      <% @participants.each do |participant| %>
        <%= render "participant_card", participant: participant %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl border border-dashed border-gray-300 p-8 text-center">
      <p class="text-gray-500 text-sm"><%= t("participants.my_trainings.empty") %></p>
      <%= link_to t("participants.my_trainings.browse_courses"), courses_path,
            class: "inline-block mt-4 text-primary-600 font-bold text-sm hover:text-primary-800 transition" %>
    </div>
  <% end %>
</div>
