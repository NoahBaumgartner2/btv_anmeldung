<%
  # Nächste anstehende Trainingssession je aktiver Anmeldung, über alle
  # Teilnehmer hinweg zusammengeführt und chronologisch sortiert.
  overview_rows = participants.flat_map do |participant|
    participant.course_registrations
      .select { |r| %w[bestätigt schnuppern].include?(r.status) }
      .filter_map do |reg|
        session =
          if reg.trial?
            reg.trial_session
          elsif reg.course.registration_mode == "single_session"
            reg.training_session
          else
            (@upcoming_by_course[reg.course_id] || []).first
          end

        next if session.blank? || session.start_time <= Time.current

        { participant: participant, reg: reg, course: reg.course, session: session }
      end
  end.sort_by { |row| row[:session].start_time }.first(15)

  # Nach Kalendertag gruppieren, damit der Wochentag als Überschrift sichtbar
  # wird — die Reihenfolge der Gruppen folgt der bereits sortierten Liste.
  overview_groups = overview_rows.group_by { |row| row[:session].start_time.in_time_zone.to_date }
%>

<% if overview_rows.any? %>
  <div class="space-y-4 sm:space-y-5">
    <% overview_groups.each do |date, rows| %>
      <div>
        <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-2 px-1"><%= I18n.l(date, format: :long_day) %></h4>
        <div class="bg-white rounded-2xl sm:rounded-3xl shadow-sm border border-gray-200 divide-y divide-gray-100">
          <% rows.each do |row| %>
            <% participant, reg, course = row[:participant], row[:reg], row[:course] %>
            <div class="flex items-center gap-3 sm:gap-4 px-4 sm:px-6 py-3.5 sm:py-4">
              <div class="h-9 w-9 sm:h-10 sm:w-10 rounded-full bg-primary-100 text-primary-700 flex items-center justify-center font-bold text-sm shrink-0">
                <%= participant.first_name&.first&.upcase %>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2 flex-wrap mb-0.5">
                  <p class="text-sm font-bold text-gray-900 truncate"><%= participant.first_name %> · <%= course.title %></p>
                  <% if reg.status == "schnuppern" %>
                    <span class="bg-amber-100 text-amber-800 text-xs font-bold px-2 py-0.5 rounded-md shrink-0"><%= reg.status_label %></span>
                  <% end %>
                </div>
                <ul>
                  <%= render "participants/upcoming_session_row", reg: reg, session: row[:session], participant: participant %>
                </ul>
              </div>
              <% if course.has_ticketing %>
                <div data-controller="modal" class="contents">
                  <button type="button" data-action="click->modal#open"
                          class="self-end shrink-0 w-11 h-11 flex items-center justify-center rounded-lg border border-gray-200 text-gray-500 hover:text-primary-700 hover:border-primary-300 transition"
                          aria-label="<%= t("participants.index.ticket_enlarge") %>">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.5h4.5v4.5h-4.5v-4.5zM15.75 4.5h4.5v4.5h-4.5v-4.5zM3.75 15h4.5v4.5h-4.5V15zM15.75 15h1.5v1.5h-1.5V15zM15.75 18h1.5v1.5h-1.5V18zM18.75 15h1.5v1.5h-1.5V15zM18.75 18h1.5v1.5h-1.5V18z"/>
                    </svg>
                  </button>
                  <div data-modal-target="dialog"
                       data-action="click->modal#backdropClose"
                       class="hidden fixed inset-0 z-100 items-center justify-center bg-gray-900/80 backdrop-blur-sm p-4">
                    <div class="bg-white p-6 sm:p-8 rounded-2xl sm:rounded-3xl shadow-2xl max-w-sm w-full flex flex-col items-center">
                      <h3 class="text-xl sm:text-2xl font-black text-gray-900 mb-1"><%= t("participants.index.ticket_modal_title", name: participant.first_name) %></h3>
                      <p class="text-gray-500 mb-6 sm:mb-8 text-center font-medium text-sm sm:text-base"><%= course.title %></p>
                      <div class="bg-white p-2 rounded-xl border-2 border-gray-100 mb-6 sm:mb-8 w-56 h-56 sm:w-64 sm:h-64 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full shadow-inner">
                        <%= generate_qr_code(scan_course_registration_url(reg)) %>
                      </div>
                      <button class="bg-gray-100 text-gray-700 font-bold py-3.5 px-6 rounded-xl hover:bg-gray-200 active:bg-gray-300 transition w-full text-base sm:text-lg min-h-12"
                              data-action="click->modal#close"><%= t("participants.index.close") %></button>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-gray-50 rounded-xl p-6 text-center border border-gray-100 border-dashed">
    <p class="text-gray-500 text-sm font-medium"><%= t("participants.index.overview_empty") %></p>
  </div>
<% end %>
