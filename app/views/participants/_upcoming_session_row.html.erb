<%
  is_unsubscribed = @unsubscribed_pairs.include?([reg.id, session.id])
  can_unsubscribe = !is_unsubscribed && session.start_time > Time.current
%>
<li class="flex items-center justify-between gap-3 text-sm">
  <span class="text-gray-700 font-medium min-w-0 flex-1"><%= session.start_time.in_time_zone.strftime("%-d. %b, %H:%M") %> <%= t("misc.time_suffix") %></span>
  <% if is_unsubscribed %>
  <% can_resubscribe = session.start_time > Time.current %>
  <% if can_resubscribe %>
    <%= form_with url: resubscribe_to_session_course_registration_path(reg), method: :post, class: "shrink-0 m-0 flex items-center" do %>
      <%= hidden_field_tag :training_session_id, session.id %>
      <button type="submit"
              class="text-xs font-bold px-2.5 py-1.5 min-h-11 min-w-[44px] flex items-center justify-center rounded-md bg-green-50 text-green-700 hover:bg-green-100 active:bg-green-200 transition cursor-pointer">
        <%= t("participants.index.resubscribe_btn") %>
      </button>
    <% end %>
  <% else %>
    <span class="shrink-0 inline-flex items-center justify-center text-xs font-bold px-2.5 py-1.5 min-h-11 rounded-md bg-red-100 text-red-600"><%= t("participants.index.unsubscribed") %></span>
  <% end %>
  <% elsif can_unsubscribe %>
    <div data-controller="confirm-unsubscribe" class="contents">
      <%= form_with url: unsubscribe_from_session_course_registration_path(reg),
                    method: :post,
                    class: "shrink-0 m-0 flex items-center",
                    data: { "unsubscribe-form": "" } do %>
        <%= hidden_field_tag :training_session_id, session.id %>
        <button type="submit"
                data-action="confirm-unsubscribe#open"
                class="text-xs font-bold px-2.5 py-1.5 min-h-11 min-w-[44px] flex items-center justify-center rounded-md bg-red-50 text-red-600 hover:bg-red-100 active:bg-red-200 transition cursor-pointer">
          <%= t("participants.index.unsubscribe_btn") %>
        </button>
      <% end %>
      <div data-confirm-unsubscribe-target="modal"
           class="hidden fixed inset-0 z-50 items-center justify-center bg-gray-900/60 backdrop-blur-sm p-4"
           data-action="click->confirm-unsubscribe#close">
        <div class="bg-white rounded-2xl shadow-xl max-w-sm w-full p-6" data-action="click->confirm-unsubscribe#close:stop">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-10 h-10 bg-red-100 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-red-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
              </svg>
            </div>
            <h2 class="text-lg font-extrabold text-gray-900 leading-snug"><%= t("participants.index.unsubscribe_session_confirm", name: participant.first_name, date: I18n.l(session.start_time, format: '%-d. %B')) %></h2>
          </div>
          <div class="flex flex-col-reverse sm:flex-row gap-3">
            <button type="button"
                    data-action="confirm-unsubscribe#close"
                    class="flex-1 inline-flex items-center justify-center bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-3 px-4 rounded-xl text-sm transition min-h-[44px] cursor-pointer">
              <%= t("participants.index.cancel") %>
            </button>
            <button type="button"
                    data-action="confirm-unsubscribe#confirm"
                    class="flex-1 inline-flex items-center justify-center bg-red-600 hover:bg-red-700 text-white font-semibold py-3 px-4 rounded-xl text-sm transition min-h-[44px] cursor-pointer">
              <%= t("participants.index.confirm_unsubscribe_session") %>
            </button>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <span class="shrink-0 inline-flex items-center justify-center text-xs text-gray-400 min-h-11">&ndash;</span>
  <% end %>
</li>
