<div class="max-w-5xl mx-auto w-full px-4 sm:px-6 mt-6 sm:mt-10 mb-16">

  <%# ── Header ─────────────────────────────────────────────────────── %>
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 sm:mb-10 gap-3 sm:gap-4">
    <div>
      <h1 class="font-extrabold text-2xl sm:text-4xl text-gray-900 tracking-tight"><%= t("participants.index.title") %></h1>
      <p class="text-gray-500 mt-1 sm:mt-2 text-sm sm:text-lg"><%= t("participants.index.subtitle") %></p>
      <%= link_to account_path, class: "inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 mt-1.5 sm:mt-2 transition" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <%= t("participants.index.account_settings") %>
      <% end %>
    </div>
    <%# Desktop: inline button, Mobile: hidden (FAB unten) %>
    <%= link_to t("participants.index.add_participant"), new_participant_path, class: "hidden sm:inline-block bg-primary-600 hover:bg-primary-700 text-white font-bold py-2.5 px-5 rounded-xl shadow-sm transition whitespace-nowrap" %>
  </div>

  <% if @participants.any? %>
    <div data-controller="tabs"
         data-tabs-active-class="border-primary-600 text-primary-700"
         data-tabs-inactive-class="border-transparent text-gray-500 hover:text-gray-800 hover:border-gray-300">

      <div class="border-b border-gray-200 mb-6">
        <nav class="-mb-px flex gap-1 sm:gap-2 overflow-x-auto" aria-label="Tabs">
          <button type="button" data-tabs-target="tab" data-tab-id="overview" data-action="click->tabs#select"
                  class="shrink-0 whitespace-nowrap px-3 sm:px-4 py-3 text-sm font-bold border-b-2 transition min-h-11 border-primary-600 text-primary-700">
            <%= t("participants.index.tab_overview") %>
          </button>
          <% @participants.each do |participant| %>
            <button type="button" data-tabs-target="tab" data-tab-id="participant-<%= participant.id %>" data-action="click->tabs#select"
                    class="shrink-0 whitespace-nowrap px-3 sm:px-4 py-3 text-sm font-bold border-b-2 transition min-h-11 border-transparent text-gray-500 hover:text-gray-800 hover:border-gray-300">
              <%= participant.first_name %>
            </button>
          <% end %>
        </nav>
      </div>

      <div data-tabs-target="panel" data-tab-id="overview">
        <%= render "overview", participants: @participants %>
      </div>

      <% @participants.each do |participant| %>
        <div data-tabs-target="panel" data-tab-id="participant-<%= participant.id %>" class="hidden">
          <%= render "participant_card", participant: participant %>
        </div>
      <% end %>
    </div>

  <% else %>
    <%# ── Leerer Zustand ───────────────────────────────────────────── %>
    <div class="bg-white p-8 sm:p-12 rounded-2xl sm:rounded-3xl shadow-sm border border-gray-200 text-center">
      <div class="w-16 h-16 rounded-full bg-primary-50 flex items-center justify-center mx-auto mb-5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
        </svg>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-2 sm:mb-3"><%= t("participants.index.no_participants_title") %></h2>
      <p class="text-gray-500 mb-6 sm:mb-8 max-w-md mx-auto text-sm sm:text-lg"><%= t("participants.index.no_participants_body") %></p>
      <%= link_to new_participant_path, class: "inline-flex items-center justify-center gap-2 bg-primary-600 hover:bg-primary-700 active:bg-primary-800 text-white font-bold py-3.5 px-8 rounded-xl shadow-sm transition text-base sm:text-lg min-h-12 w-full sm:w-auto" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
        </svg>
        <%= t("participants.index.add_first_child") %>
      <% end %>
    </div>
  <% end %>

  <%# ── FAB: "Person erfassen" (nur Mobile, nur wenn Kinder vorhanden) ── %>
  <% if @participants.any? %>
    <%= link_to new_participant_path, class: "sm:hidden fixed bottom-6 mb-safe right-4 z-50 w-14 h-14 bg-primary-600 hover:bg-primary-700 active:bg-primary-800 text-white rounded-full shadow-lg flex items-center justify-center transition", aria: { label: t("participants.index.add_participant_aria") } do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
      </svg>
    <% end %>
  <% end %>

</div>
