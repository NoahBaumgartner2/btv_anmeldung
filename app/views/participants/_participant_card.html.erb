        <div class="bg-white rounded-2xl sm:rounded-3xl shadow-sm border border-gray-200 overflow-hidden">

          <% if participant.date_of_birth.blank? %>
            <div class="bg-amber-50 border-b border-amber-200 px-4 sm:px-6 py-3 flex items-center justify-between gap-3">
              <p class="text-sm font-semibold text-amber-800">Profil unvollständig – bitte Angaben ergänzen</p>
              <%= link_to "Jetzt ergänzen", edit_participant_path(participant),
                    class: "shrink-0 text-xs font-bold text-white bg-amber-600 hover:bg-amber-700 px-3 py-1.5 rounded-lg transition" %>
            </div>
          <% end %>

          <%# ── Teilnehmer-Header ───────────────────────────────────── %>
          <div class="bg-gray-50 px-4 sm:px-6 py-4 sm:py-5 border-b border-gray-100">
            <div class="flex items-center gap-3 sm:gap-4">
              <div class="h-11 w-11 sm:h-12 sm:w-12 rounded-full bg-primary-100 text-primary-700 flex items-center justify-center font-bold text-base sm:text-lg shrink-0">
                <%= participant.first_name&.first&.upcase %><%= participant.last_name&.first&.upcase %>
              </div>
              <div class="min-w-0 flex-1">
                <h2 class="text-xl sm:text-2xl font-bold text-gray-900 truncate"><%= participant.first_name %> <%= participant.last_name %></h2>
                <p class="text-sm font-medium text-gray-500"><%= t("participants.index.birthdate_prefix") %><%= participant.date_of_birth&.strftime("%d.%m.%Y") || t("participants.index.not_provided") %></p>
              </div>
              <%# Desktop: Text-Button, Mobile: Icon-Button %>
              <%= link_to edit_participant_path(participant), class: "hidden sm:inline-flex text-sm font-bold text-gray-600 hover:text-gray-900 bg-white border border-gray-300 shadow-sm px-4 py-2 rounded-lg transition shrink-0" do %>
                <%= t("participants.index.edit") %>
              <% end %>
              <%= link_to edit_participant_path(participant), class: "sm:hidden flex items-center justify-center w-11 h-11 rounded-xl bg-white border border-gray-300 shadow-sm text-gray-600 active:bg-gray-100 shrink-0", aria: { label: t("participants.index.edit_aria", name: participant.first_name) } do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
              <% end %>
            </div>
          </div>

          <div class="p-4 sm:p-6">
            <%
              today    = Date.today
              all_regs = participant.course_registrations

              # ── Semester-Kurse aufteilen ─────────────────────────────────
              semester_regs = all_regs.reject { |r|
                r.course.registration_mode == "single_session" || r.status == "ausstehend" || r.abo_booking?
              }
              active_semester = semester_regs.select { |r|
                r.status != "storniert" &&
                (r.course.end_date.nil? || r.course.end_date >= today)
              }
              past_semester = semester_regs.select { |r|
                r.status == "storniert" ||
                (r.course.end_date.present? && r.course.end_date < today)
              }

              # ── Drop-In Kurse aufteilen ──────────────────────────────────
              single_session_all = all_regs
                .select  { |r| r.course.registration_mode == "single_session" && r.status != "ausstehend" && !r.abo_booking? }
                .group_by(&:course_id)
                .transform_values { |regs|
                  regs
                    .group_by(&:training_session_id)
                    .map { |_tsid, group| group.sort_by { |r| [r.status == "bestätigt" ? 0 : 1, -(r.id)] }.first }
                    .sort_by { |r| r.training_session&.start_time || Time.at(0) }
                }

              active_single  = single_session_all.select { |_, regs|
                c = regs.first.course
                c.end_date.nil? || c.end_date >= today
              }
              past_single    = single_session_all.reject { |_, regs|
                c = regs.first.course
                c.end_date.nil? || c.end_date >= today
              }

              any_active = active_semester.any? || active_single.any?
              any_past   = past_semester.any?   || past_single.any?
            %>

            <%# ── Aktive Kurse ────────────────────────────────────────── %>
            <% if any_active %>
              <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4 sm:mb-5"><%= t("participants.index.enrolled_section") %></h3>

              <%# ── Semester-Karten ──────────────────────────────────── %>
              <% if active_semester.any? %>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 <%= active_single.any? ? 'mb-4 sm:mb-5' : '' %>">
                  <% active_semester.each do |reg| %>
                    <% course = reg.course %>
                    <div class="bg-white border border-green-200 rounded-2xl p-4 sm:p-5 shadow-sm relative flex flex-col h-full hover:shadow-md transition">

                      <div class="absolute top-3 sm:top-4 right-3 sm:right-4">
                        <% case reg.status %>
                        <% when "bestätigt" %>
                          <span class="bg-green-100 text-green-800 text-xs font-bold px-2 py-1 rounded-md"><%= t("participants.index.confirmed") %></span>
                        <% when "schnuppern" %>
                          <span class="bg-amber-100 text-amber-800 text-xs font-bold px-2 py-1 rounded-md"><%= reg.status_label %></span>
                        <% when "warteliste" %>
                          <span class="bg-orange-100 text-orange-800 text-xs font-bold px-2 py-1 rounded-md"><%= t("participants.index.waitlist") %></span>
                        <% when "ausstehend" %>
                          <span class="bg-yellow-100 text-yellow-700 text-xs font-bold px-2 py-1 rounded-md"><%= reg.status_label %></span>
                        <% else %>
                          <span class="bg-gray-100 text-gray-600 text-xs font-bold px-2 py-1 rounded-md"><%= reg.status_label %></span>
                        <% end %>
                      </div>

                      <h4 class="font-bold text-gray-900 pr-20 sm:pr-16 mb-1 text-base sm:text-lg"><%= course.title %></h4>
                      <p class="text-xs font-bold text-primary-600 mb-3 sm:mb-4 uppercase tracking-wide">
                        <%= course.registration_type_label %>
                        <% if course.abo? %>
                          <span class="ml-1 bg-indigo-100 text-indigo-700 px-1.5 py-0.5 rounded font-bold"><%= t("participants.index.abo_label") %></span>
                        <% end %>
                      </p>

                      <% if reg.status == "warteliste" %>
                        <p class="text-xs font-semibold text-orange-700 -mt-2 mb-3 sm:mb-4">
                          <%= t("participants.index.waitlist_position", position: reg.waitlist_position) %>
                        </p>
                      <% end %>

                      <%# ── Regulär anmelden / bezahlen ──────────────── %>
                      <% if reg.trial? %>
                        <%= button_to t("participants.index.convert_trial_btn"),
                              convert_trial_course_registration_path(reg),
                              method: :post,
                              class: "w-full mb-3 sm:mb-4 inline-flex items-center justify-center bg-primary-600 hover:bg-primary-700 active:bg-primary-800 text-white font-bold py-2.5 px-4 rounded-xl text-sm transition cursor-pointer min-h-11" %>
                      <% elsif reg.payable? %>
                        <%= link_to t("participants.index.pay_now_btn"),
                              checkout_preview_registration_path(reg),
                              class: "w-full mb-3 sm:mb-4 inline-flex items-center justify-center bg-primary-600 hover:bg-primary-700 active:bg-primary-800 text-white font-bold py-2.5 px-4 rounded-xl text-sm transition min-h-11" %>
                      <% end %>

                      <%# ── Nächste Trainings ─────────────────────────── %>
                      <% upcoming_sessions = reg.trial? ? [reg.trial_session].compact : (@upcoming_by_course[course.id] || []).first(3) %>
                      <% if %w[bestätigt schnuppern].include?(reg.status) && upcoming_sessions.any? %>
                        <div class="mt-3 sm:mt-4 pt-3 sm:pt-4 border-t border-gray-100">
                          <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2 sm:mb-3"><%= t("participants.index.upcoming_trainings") %></p>
                          <ul class="space-y-2">
                            <% upcoming_sessions.each do |session| %>
                              <% is_unsubscribed = @unsubscribed_pairs.include?([reg.id, session.id]) %>
                              <% can_unsubscribe = !is_unsubscribed && session.start_time > Time.current %>
                              <li class="flex items-center justify-between gap-3 text-sm">
                                <span class="text-gray-700 font-medium min-w-0 flex-1"><%= session.start_time.in_time_zone.strftime("%-d. %b, %H:%M") %> <%= t("misc.time_suffix") %></span>
                                <% if is_unsubscribed %>
                                <% can_resubscribe = session.start_time > Time.current %>
                                <% if can_resubscribe %>
                                  <%= form_with url: resubscribe_to_session_course_registration_path(reg), method: :post, class: "shrink-0 m-0 flex items-center" do %>
                                    <%= hidden_field_tag :training_session_id, session.id %>
                                    <button type="submit"
                                            class="text-xs font-bold px-2.5 py-1.5 min-h-11 min-w-[44px] flex items-center justify-center rounded-md bg-green-50 text-green-700 hover:bg-green-100 active:bg-green-200 transition cursor-pointer">
                                      <%= t("participants.index.resubscribe_btn") %>
                                    </button>
                                  <% end %>
                                <% else %>
                                  <span class="shrink-0 inline-flex items-center justify-center text-xs font-bold px-2.5 py-1.5 min-h-11 rounded-md bg-red-100 text-red-600"><%= t("participants.index.unsubscribed") %></span>
                                <% end %>
                                <% elsif can_unsubscribe %>
                                  <div data-controller="confirm-unsubscribe" class="contents">
                                    <%= form_with url: unsubscribe_from_session_course_registration_path(reg),
                                                  method: :post,
                                                  class: "shrink-0 m-0 flex items-center",
                                                  data: { "unsubscribe-form": "" } do %>
                                      <%= hidden_field_tag :training_session_id, session.id %>
                                      <button type="submit"
                                              data-action="confirm-unsubscribe#open"
                                              class="text-xs font-bold px-2.5 py-1.5 min-h-11 min-w-[44px] flex items-center justify-center rounded-md bg-red-50 text-red-600 hover:bg-red-100 active:bg-red-200 transition cursor-pointer">
                                        <%= t("participants.index.unsubscribe_btn") %>
                                      </button>
                                    <% end %>
                                    <div data-confirm-unsubscribe-target="modal"
                                         class="hidden fixed inset-0 z-50 items-center justify-center bg-gray-900/60 backdrop-blur-sm p-4"
                                         data-action="click->confirm-unsubscribe#close">
                                      <div class="bg-white rounded-2xl shadow-xl max-w-sm w-full p-6" data-action="click->confirm-unsubscribe#close:stop">
                                        <div class="flex items-start gap-4 mb-4">
                                          <div class="w-10 h-10 bg-red-100 rounded-xl flex items-center justify-center shrink-0">
                                            <svg class="w-5 h-5 text-red-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
                                            </svg>
                                          </div>
                                          <h2 class="text-lg font-extrabold text-gray-900 leading-snug"><%= t("participants.index.unsubscribe_session_confirm", name: participant.first_name, date: I18n.l(session.start_time, format: '%-d. %B')) %></h2>
                                        </div>
                                        <div class="flex flex-col-reverse sm:flex-row gap-3">
                                          <button type="button"
                                                  data-action="confirm-unsubscribe#close"
                                                  class="flex-1 inline-flex items-center justify-center bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-3 px-4 rounded-xl text-sm transition min-h-[44px] cursor-pointer">
                                            <%= t("participants.index.cancel") %>
                                          </button>
                                          <button type="button"
                                                  data-action="confirm-unsubscribe#confirm"
                                                  class="flex-1 inline-flex items-center justify-center bg-red-600 hover:bg-red-700 text-white font-semibold py-3 px-4 rounded-xl text-sm transition min-h-[44px] cursor-pointer">
                                            <%= t("participants.index.confirm_unsubscribe_session") %>
                                          </button>
                                        </div>
                                      </div>
                                    </div>
                                  </div>
                                <% else %>
                                  <span class="shrink-0 inline-flex items-center justify-center text-xs text-gray-400 min-h-11">&ndash;</span>
                                <% end %>
                              </li>
                            <% end %>
                          </ul>
                        </div>
                      <% end %>

                      <%# ── Schnuppertermin selbst ändern (Overlay) ─────── %>
                      <% if reg.trial? && !reg.trial_expired? && reg.trial_session && reg.trial_session.start_time > Time.current %>
                        <% other_sessions = course.training_sessions
                                                   .where(is_canceled: false)
                                                   .where("start_time > ?", Time.current)
                                                   .where.not(id: reg.trial_session_id)
                                                   .order(:start_time) %>
                        <div data-controller="modal" class="contents">
                          <button type="button" data-action="click->modal#open"
                                  class="mt-2 text-xs font-bold text-primary-600 hover:text-primary-800 cursor-pointer">
                            <%= t("participants.index.change_trial_date_btn") %>
                          </button>

                          <div data-modal-target="dialog"
                               data-action="click->modal#backdropClose"
                               class="hidden fixed inset-0 z-50 items-center justify-center bg-gray-900/60 backdrop-blur-sm p-4">
                            <div class="bg-white rounded-2xl shadow-xl max-w-sm w-full p-6">
                              <h2 class="text-lg font-extrabold text-gray-900 mb-4"><%= t("participants.index.change_trial_date_modal_title") %></h2>
                              <% if other_sessions.any? %>
                                <%= form_with url: change_trial_session_course_registration_path(reg), method: :post, class: "space-y-4" do %>
                                  <div>
                                    <label class="block text-xs font-bold text-gray-700 mb-1.5 uppercase tracking-wide"><%= t("participants.index.change_trial_date_prompt") %></label>
                                    <%= select_tag :trial_session_id,
                                          options_from_collection_for_select(other_sessions, :id, ->(s) { I18n.l(s.start_time, format: :long) }),
                                          class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white" %>
                                  </div>
                                  <div class="flex flex-col-reverse sm:flex-row gap-3">
                                    <button type="button" data-action="click->modal#close"
                                            class="flex-1 inline-flex items-center justify-center bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-3 px-4 rounded-xl text-sm transition min-h-[44px] cursor-pointer">
                                      <%= t("participants.index.cancel") %>
                                    </button>
                                    <button type="submit"
                                            class="flex-1 inline-flex items-center justify-center bg-primary-600 hover:bg-primary-700 text-white font-semibold py-3 px-4 rounded-xl text-sm transition min-h-[44px] cursor-pointer">
                                      <%= t("participants.index.change_trial_date_submit") %>
                                    </button>
                                  </div>
                                <% end %>
                              <% else %>
                                <p class="text-sm text-gray-500 mb-5"><%= t("participants.index.change_trial_date_no_sessions") %></p>
                                <button type="button" data-action="click->modal#close"
                                        class="w-full inline-flex items-center justify-center bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-3 px-4 rounded-xl text-sm transition min-h-[44px] cursor-pointer">
                                  <%= t("participants.index.close") %>
                                </button>
                              <% end %>
                            </div>
                          </div>
                        </div>
                      <% end %>

                      <%# ── Abo-Eintritte & gebuchte Trainings ─────────── %>
                      <% if course.abo? && reg.status == "bestätigt" %>
                        <div class="mt-3 sm:mt-4 pt-3 sm:pt-4 border-t border-gray-100">
                          <div class="flex items-center justify-between mb-2">
                            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">
                              <%= t("participants.index.abo_booked_sessions") %>
                            </p>
                            <span class="text-xs font-bold text-primary-600">
                              <%= t("participants.index.abo_entries_remaining",
                                    count: reg.abo_entries_remaining.to_i) %>
                            </span>
                          </div>
                          <% abo_bookings = reg.abo_bookings.includes(:training_session)
                                              .where.not(status: "storniert")
                                              .select { |b| b.training_session&.start_time.present? }
                                              .sort_by { |b| b.training_session.start_time }
                                              .first(5) %>
                          <% if abo_bookings.any? %>
                            <ul class="space-y-1.5 mb-3">
                              <% abo_bookings.each do |booking| %>
                                <li class="flex items-center justify-between gap-3 text-xs">
                                  <span class="min-w-0 flex-1">
                                    <span class="block font-medium text-gray-700 truncate"><%= booking.training_session.start_time.in_time_zone.strftime("%-d. %b %Y, %H:%M") %></span>
                                    <span class="block text-gray-400 truncate"><%= booking.course.title %></span>
                                    <% if booking.status == "warteliste" %>
                                      <span class="inline-flex items-center bg-orange-100 text-orange-700 font-bold px-1.5 py-0.5 rounded-full"><%= t("participants.index.waitlist") %></span>
                                    <% end %>
                                  </span>
                                  <% if booking.training_session.start_time > Time.current %>
                                    <div data-controller="confirm-unsubscribe" class="contents">
                                      <%= form_with url: cancel_course_registration_path(booking),
                                                    method: :post,
                                                    class: "shrink-0 m-0 flex items-center",
                                                    data: { "unsubscribe-form": "" } do %>
                                        <button type="submit"
                                                data-action="confirm-unsubscribe#open"
                                                class="text-xs font-bold px-2.5 py-1.5 min-h-11 min-w-[44px] flex items-center justify-center rounded-md bg-red-50 text-red-600 hover:bg-red-100 active:bg-red-200 transition cursor-pointer">
                                          <%= t("participants.index.abo_cancel_booking_btn") %>
                                        </button>
                                      <% end %>
                                      <div data-confirm-unsubscribe-target="modal"
                                           class="hidden fixed inset-0 z-50 items-center justify-center bg-gray-900/60 backdrop-blur-sm p-4"
                                           data-action="click->confirm-unsubscribe#close">
                                        <div class="bg-white rounded-2xl shadow-xl max-w-sm w-full p-6" data-action="click->confirm-unsubscribe#close:stop">
                                          <h2 class="text-lg font-extrabold text-gray-900 mb-4">Training stornieren?</h2>
                                          <p class="text-sm text-gray-600 mb-5">Der Eintritt wird automatisch zurückgebucht.</p>
                                          <div class="flex flex-col-reverse sm:flex-row gap-3">
                                            <button type="button" data-action="confirm-unsubscribe#close"
                                                    class="flex-1 inline-flex items-center justify-center bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-3 px-4 rounded-xl text-sm transition min-h-[44px] cursor-pointer">
                                              <%= t("participants.index.cancel") %>
                                            </button>
                                            <button type="button" data-action="confirm-unsubscribe#confirm"
                                                    class="flex-1 inline-flex items-center justify-center bg-red-600 hover:bg-red-700 text-white font-semibold py-3 px-4 rounded-xl text-sm transition min-h-[44px] cursor-pointer">
                                              Ja, stornieren
                                            </button>
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  <% else %>
                                    <span class="text-xs text-gray-400 shrink-0"><%= t("participants.index.past") %></span>
                                  <% end %>
                                </li>
                              <% end %>
                            </ul>
                          <% else %>
                            <p class="text-xs text-gray-400 mb-3"><%= t("participants.index.abo_no_sessions") %></p>
                          <% end %>
                          <% unless reg.abo_exhausted? %>
                            <%= link_to t("participants.index.abo_book_btn"),
                                  abo_sessions_course_registration_path(reg),
                                  class: "w-full inline-flex items-center justify-center bg-primary-600 hover:bg-primary-700 active:bg-primary-800 text-white font-bold py-2.5 px-4 rounded-xl text-sm transition min-h-11" %>
                          <% end %>
                        </div>
                      <% end %>

                      <%# ── Ticket / QR-Code ──────────────────────────── %>
                      <% show_bottom_block = course.has_ticketing || !["bestätigt", "schnuppern"].include?(reg.status) %>
                      <% if show_bottom_block %>
                        <div class="mt-auto pt-4 sm:pt-5 border-t border-gray-100 flex flex-col items-center">
                          <% if ["bestätigt", "schnuppern"].include?(reg.status) && course.has_ticketing %>
                            <div data-controller="modal" class="contents">
                              <div class="cursor-pointer hover:scale-105 active:scale-95 transition transform group w-full flex flex-col items-center"
                                   data-action="click->modal#open">
                                <div class="bg-white p-2 rounded-xl border-2 border-dashed border-gray-300 mb-3 w-28 h-28 sm:w-32 sm:h-32 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full group-hover:border-purple-400">
                                  <%= generate_qr_code(scan_course_registration_url(reg)) %>
                                </div>
                                <p class="text-xs text-purple-600 font-bold uppercase tracking-wider text-center"><%= t("participants.index.ticket_enlarge") %></p>
                              </div>
                              <%# QR Modal %>
                              <div data-modal-target="dialog"
                                   data-action="click->modal#backdropClose"
                                   class="hidden fixed inset-0 z-100 items-center justify-center bg-gray-900/80 backdrop-blur-sm p-4">
                                <div class="bg-white p-6 sm:p-8 rounded-2xl sm:rounded-3xl shadow-2xl max-w-sm w-full flex flex-col items-center">
                                  <h3 class="text-xl sm:text-2xl font-black text-gray-900 mb-1"><%= t("participants.index.ticket_modal_title", name: participant.first_name) %></h3>
                                  <p class="text-gray-500 mb-6 sm:mb-8 text-center font-medium text-sm sm:text-base"><%= course.title %></p>
                                  <div class="bg-white p-2 rounded-xl border-2 border-gray-100 mb-6 sm:mb-8 w-56 h-56 sm:w-64 sm:h-64 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full shadow-inner">
                                    <%= generate_qr_code(scan_course_registration_url(reg)) %>
                                  </div>
                                  <button class="bg-gray-100 text-gray-700 font-bold py-3.5 px-6 rounded-xl hover:bg-gray-200 active:bg-gray-300 transition w-full text-base sm:text-lg min-h-12"
                                          data-action="click->modal#close"><%= t("participants.index.close") %></button>
                                </div>
                              </div>
                            </div>
                          <% else %>
                            <div class="bg-orange-50 rounded-xl p-4 text-center w-full border border-orange-100">
                              <span class="text-xs text-orange-600 font-bold uppercase"><%= t("participants.index.waiting_for_spot") %></span>
                            </div>
                          <% end %>
                        </div>
                      <% end %>

                      <%# Link zu weiteren Kursen derselben Kategorie %>
                      <% if course.category.present? && @more_courses_by_category[course.category]&.any? %>
                        <div class="mt-3 pt-3 border-t border-gray-100 text-center">
                          <%= link_to courses_path(anchor: course.category.parameterize),
                                class: "text-xs font-semibold text-primary-600 hover:text-primary-800 hover:underline transition" do %>
                            <%= t("participants.index.more_courses_in_category", category: course.category) %> →
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>

              <%# ── Drop-In Karten (aktiv) ───────────────────────────── %>
              <% active_single.each do |course_id, regs| %>
                <% course = regs.first.course %>
                <%
                  upcoming_regs = regs.select { |r| ["bestätigt", "schnuppern"].include?(r.status) && r.training_session.present? && !r.training_session.past? }
                  next_reg      = upcoming_regs.min_by { |r| r.training_session.start_time }
                  active_count  = upcoming_regs.size
                  waitlist_count = regs.count { |r| r.status == "warteliste" && r.training_session.present? && !r.training_session.past? }
                %>
                <div class="bg-white border border-blue-200 rounded-2xl shadow-sm hover:shadow-md transition mb-4 sm:mb-5">
                  <div class="px-4 sm:px-5 pt-4 sm:pt-5 pb-3 sm:pb-4 flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <h4 class="font-bold text-gray-900 text-base sm:text-lg leading-tight truncate"><%= course.title %></h4>
                      <p class="text-xs font-bold text-primary-600 mt-0.5 uppercase tracking-wide"><%= t("participants.index.drop_in_label") %></p>
                    </div>
                    <div class="shrink-0 flex flex-col items-end gap-1">
                      <% if active_count > 0 %>
                        <span class="bg-blue-100 text-blue-700 text-xs font-bold px-2.5 py-1 rounded-md mt-0.5">
                          <%= t("participants.index.dates_count", count: active_count) %>
                        </span>
                      <% elsif waitlist_count == 0 %>
                        <span class="bg-gray-100 text-gray-400 text-xs font-bold px-2.5 py-1 rounded-md mt-0.5"><%= t("participants.index.no_active_dates") %></span>
                      <% end %>
                      <% if waitlist_count > 0 %>
                        <span class="bg-orange-100 text-orange-800 text-xs font-bold px-2.5 py-1 rounded-md">
                          <%= t("participants.index.waitlist_dates_count", count: waitlist_count) %>
                        </span>
                      <% end %>
                    </div>
                  </div>
                  <div class="border-t border-gray-100 divide-y divide-gray-50">
                    <% regs.each do |reg| %>
                      <% session = reg.training_session %>
                      <% next unless session %>
                      <% is_past      = session.past? %>
                      <% is_storniert = reg.status == "storniert" %>
                      <% is_warteliste = reg.status == "warteliste" %>
                      <div class="flex items-center justify-between gap-2 sm:gap-3 px-4 sm:px-5 py-3 <%= is_past || is_storniert ? 'opacity-50' : '' %>">
                        <div class="flex items-center gap-2 sm:gap-2.5 min-w-0 flex-1">
                          <div class="shrink-0 w-2 h-2 rounded-full <%= is_past || is_storniert ? 'bg-gray-300' : is_warteliste ? 'bg-orange-400' : 'bg-blue-400' %>"></div>
                          <span class="text-sm font-medium text-gray-800 truncate <%= is_storniert ? 'line-through' : '' %>">
                            <%= session.start_time.in_time_zone.strftime("%-d. %b %Y, %H:%M") %> <%= t("misc.time_suffix") %>
                          </span>
                        </div>
                        <div class="shrink-0">
                          <% if is_storniert %>
                            <span class="inline-flex items-center justify-center text-xs font-bold px-2.5 py-1.5 min-h-11 rounded-md bg-red-100 text-red-600"><%= t("participants.index.unsubscribed") %></span>
                          <% elsif is_past %>
                            <span class="inline-flex items-center justify-center text-xs font-bold px-2.5 py-1.5 min-h-11 rounded-md bg-gray-100 text-gray-400"><%= t("participants.index.past") %></span>
                          <% elsif is_warteliste %>
                            <span class="inline-flex items-center justify-center text-xs font-bold px-2.5 py-1.5 min-h-11 rounded-md bg-orange-100 text-orange-800">
                              <%= t("participants.index.waitlist_position", position: reg.waitlist_position) %>
                            </span>
                          <% else %>
                            <span class="inline-flex items-center justify-center text-xs text-gray-400 min-h-11">&ndash;</span>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                  <% if course.has_ticketing && next_reg %>
                    <div data-controller="modal" class="contents">
                      <div class="border-t border-gray-100 px-4 sm:px-5 py-4">
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3"><%= t("participants.index.ticket_next_session") %></p>
                        <div class="flex items-center gap-4">
                          <div class="cursor-pointer hover:scale-105 active:scale-95 transition transform group flex flex-col items-center shrink-0"
                               data-action="click->modal#open">
                            <div class="bg-white p-1.5 rounded-xl border-2 border-dashed border-gray-300 w-20 h-20 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full group-hover:border-purple-400">
                              <%= generate_qr_code(scan_course_registration_url(next_reg)) %>
                            </div>
                          </div>
                          <div class="min-w-0">
                            <p class="text-sm font-bold text-gray-800"><%= next_reg.training_session.start_time.in_time_zone.strftime("%-d. %B %Y") %></p>
                            <p class="text-xs text-gray-500"><%= next_reg.training_session.start_time.in_time_zone.strftime("%H:%M") %> &ndash; <%= next_reg.training_session.end_time&.in_time_zone&.strftime("%H:%M") %> <%= t("misc.time_suffix") %></p>
                            <button class="mt-1.5 text-xs text-purple-600 font-bold hover:underline min-h-11 flex items-center"
                                    data-action="click->modal#open"><%= t("participants.index.enlarge") %></button>
                          </div>
                        </div>
                      </div>
                      <%# QR Modal %>
                      <div data-modal-target="dialog"
                           data-action="click->modal#backdropClose"
                           class="hidden fixed inset-0 z-100 items-center justify-center bg-gray-900/80 backdrop-blur-sm p-4">
                        <div class="bg-white p-6 sm:p-8 rounded-2xl sm:rounded-3xl shadow-2xl max-w-sm w-full flex flex-col items-center">
                          <h3 class="text-xl sm:text-2xl font-black text-gray-900 mb-1"><%= t("participants.index.ticket_modal_title", name: participant.first_name) %></h3>
                          <p class="text-gray-500 mb-1 text-center font-medium text-sm sm:text-base"><%= course.title %></p>
                          <p class="text-sm text-gray-400 mb-6 sm:mb-8 text-center"><%= next_reg.training_session.start_time.in_time_zone.strftime("%-d. %B %Y, %H:%M") %> <%= t("misc.time_suffix") %></p>
                          <div class="bg-white p-2 rounded-xl border-2 border-gray-100 mb-6 sm:mb-8 w-56 h-56 sm:w-64 sm:h-64 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full shadow-inner">
                            <%= generate_qr_code(scan_course_registration_url(next_reg)) %>
                          </div>
                          <button class="bg-gray-100 text-gray-700 font-bold py-3.5 px-6 rounded-xl hover:bg-gray-200 active:bg-gray-300 transition w-full text-base sm:text-lg min-h-12"
                                  data-action="click->modal#close"><%= t("participants.index.close") %></button>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>

              <div class="mt-5 sm:mt-6 text-center">
                <%= link_to t("participants.index.to_courses"), courses_path,
                      class: "inline-block text-primary-600 font-bold hover:underline min-h-11 leading-[44px]" %>
              </div>

            <% else %>
              <div class="bg-gray-50 rounded-xl p-6 text-center border border-gray-100 border-dashed">
                <p class="text-gray-500 text-sm font-medium"><%= t("participants.index.not_enrolled", name: participant.first_name) %></p>
                <%= link_to t("participants.index.to_courses"), courses_path, class: "mt-3 inline-block text-primary-600 font-bold hover:underline min-h-11 leading-[44px]" %>
              </div>
            <% end %>

            <%# ── Vergangene Kurse (Accordion) ───────────────────────── %>
            <% if any_past %>
              <details class="mt-5 sm:mt-6 group">
                <summary class="flex items-center gap-2 cursor-pointer list-none select-none text-sm font-bold text-gray-400 hover:text-gray-600 transition min-h-11">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                  <%= t("participants.index.past_section") %>
                  <span class="font-normal text-gray-300">(<%= past_semester.size + past_single.size %>)</span>
                </summary>

                <div class="mt-3 sm:mt-4 space-y-2 sm:space-y-3">

                  <%# Vergangene Semester-Karten %>
                  <% past_semester.each do |reg| %>
                    <% course = reg.course %>
                    <% storniert = reg.status == "storniert" %>
                    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-3.5 sm:p-4 flex items-center justify-between gap-3 opacity-70">
                      <div class="min-w-0">
                        <p class="font-bold text-gray-600 text-sm truncate"><%= course.title %></p>
                        <p class="text-xs text-gray-400 mt-0.5">
                          <% if course.end_date.present? %>
                            <%= t("participants.index.course_ended", date: course.end_date.strftime("%-d. %B %Y")) %>
                          <% end %>
                        </p>
                      </div>
                      <% if storniert %>
                        <span class="shrink-0 bg-red-100 text-red-500 text-xs font-bold px-2 py-1 rounded-md"><%= t("participants.index.cancelled") %></span>
                      <% else %>
                        <span class="shrink-0 bg-gray-200 text-gray-500 text-xs font-bold px-2 py-1 rounded-md"><%= t("participants.index.completed") %></span>
                      <% end %>
                    </div>
                  <% end %>

                  <%# Vergangene Drop-In Karten %>
                  <% past_single.each do |_, regs| %>
                    <% course = regs.first.course %>
                    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-3.5 sm:p-4 flex items-center justify-between gap-3 opacity-70">
                      <div class="min-w-0">
                        <p class="font-bold text-gray-600 text-sm truncate"><%= course.title %></p>
                        <p class="text-xs text-gray-400 mt-0.5">
                          <%= t("participants.index.drop_in_label") %> &middot; <%= t("participants.index.dates_count", count: regs.size) %>
                          <% if course.end_date.present? %>
                            &middot; <%= t("participants.index.course_ended", date: course.end_date.strftime("%-d. %B %Y")) %>
                          <% end %>
                        </p>
                      </div>
                      <span class="shrink-0 bg-gray-200 text-gray-500 text-xs font-bold px-2 py-1 rounded-md"><%= t("participants.index.completed") %></span>
                    </div>
                  <% end %>

                </div>
              </details>
            <% end %>

          </div>
        </div>
