<div class="max-w-4xl mx-auto mt-6 sm:mt-10 mb-16 px-4">

  <%= render "admin/shared/section_header" %>

  <%# ── Header ─────────────────────────────────────────────────────────── %>
  <div class="mb-6">
    <h2 class="text-xl sm:text-2xl font-bold text-gray-900"><%= t(".title") %></h2>
    <p class="text-gray-500 mt-1 text-sm sm:text-base"><%= t(".subtitle") %></p>
  </div>

  <% if @open_registrations.any? %>
    <div class="bg-white shadow-sm ring-1 ring-slate-200/80 rounded-3xl overflow-hidden divide-y divide-gray-100">
      <% @open_registrations.each do |registration| %>
        <%= link_to manage_course_path(registration.course),
              class: "group flex items-center gap-4 px-4 sm:px-6 py-4 hover:bg-gray-50 active:bg-gray-100 transition" do %>
          <div class="min-w-0 flex-1">
            <p class="font-bold text-gray-900 text-sm truncate"><%= registration.participant.first_name %> <%= registration.participant.last_name %></p>
            <p class="text-xs text-gray-500 mt-0.5 truncate"><%= registration.course.title %> · <%= registration.paid_amount_display %></p>
            <p class="text-xs text-gray-400 mt-0.5 truncate">
              <%= registration.status_label %> · <%= t(".since", date: l(registration.created_at.to_date)) %>
              <% if registration.participant.user %> · <%= registration.participant.user.email %><% end %>
            </p>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="ml-auto h-4 w-4 text-gray-300 group-hover:text-gray-500 shrink-0 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white shadow-sm ring-1 ring-slate-200/80 rounded-3xl px-6 py-16 text-center">
      <div class="mx-auto w-14 h-14 rounded-full bg-green-100 flex items-center justify-center mb-4">
        <svg class="w-7 h-7 text-green-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <p class="text-gray-700 font-bold"><%= t(".empty_title") %></p>
      <p class="text-gray-400 text-sm mt-1"><%= t(".empty_text") %></p>
    </div>
  <% end %>

</div>
