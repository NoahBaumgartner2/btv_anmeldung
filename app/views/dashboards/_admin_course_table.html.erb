<%# ── Kurs-Übersicht ──────────────────────────────────────────────────── %>
<%= turbo_frame_tag "course_overview" do %>
  <%= form_with url: dashboards_admin_path, method: :get,
        data: { controller: "auto-submit" }, class: "flex flex-col sm:flex-row gap-3 mb-4" do %>
    <%= text_field_tag :course_q, params[:course_q],
          placeholder: t("dashboards.admin.table.search_placeholder"),
          data: { action: "change->auto-submit#submit" },
          class: "flex-1 rounded-xl border border-slate-900/15 px-3 py-2.5 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-900/20" %>
    <%= select_tag :category,
          options_for_select([ [ t("dashboards.admin.table.all_categories"), "" ] ] + @course_categories.map { |c| [ c, c ] }, params[:category]),
          data: { action: "change->auto-submit#submit" },
          class: "rounded-xl border border-slate-900/15 px-3 py-2.5 text-sm shadow-sm bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/20" %>
    <%= select_tag :registration_mode,
          options_for_select([ [ t("dashboards.admin.table.all_modes"), "" ] ] + @course_registration_modes.map { |m| [ Course.new(registration_mode: m).registration_mode_label, m ] }, params[:registration_mode]),
          data: { action: "change->auto-submit#submit" },
          class: "rounded-xl border border-slate-900/15 px-3 py-2.5 text-sm shadow-sm bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/20" %>
    <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white font-bold px-5 py-2.5 rounded-full text-sm transition cursor-pointer"><%= t("dashboards.admin.table.filter_btn") %></button>
  <% end %>

  <div class="bg-white shadow-sm ring-1 ring-slate-200/80 rounded-3xl overflow-hidden">

    <%# Mobile: Cards %>
    <div class="sm:hidden divide-y divide-gray-100">
      <% @courses.each do |course| %>
        <div class="p-4">
          <div class="flex items-start justify-between gap-3 mb-2">
            <div class="min-w-0">
              <h3 class="font-bold text-gray-900 text-sm truncate"><%= course.title %></h3>
              <p class="text-xs text-gray-500 mt-0.5"><%= [ course.registration_type_label, course.term&.name ].compact_blank.join(" · ") %></p>
            </div>
            <span class="shrink-0 text-xs font-bold text-primary-600 bg-primary-50 px-2 py-1 rounded-md">
              <%= course.occupied_spots %> TN
            </span>
          </div>
          <%= link_to t("dashboards.admin.table.manage"), manage_course_path(course),
                data: { turbo_frame: "_top" },
                class: "block w-full text-center text-red-600 font-bold bg-red-50 active:bg-red-100 px-3 py-2.5 rounded-full text-sm min-h-11 leading-6 transition" %>
        </div>
      <% end %>
      <% if @courses.empty? %>
        <p class="p-6 text-center text-sm text-gray-400"><%= t("dashboards.admin.table.no_results") %></p>
      <% end %>
    </div>

    <%# Desktop: Tabelle %>
    <table class="hidden sm:table min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="py-3 px-4 text-left text-xs font-bold text-gray-500 uppercase"><%= t("dashboards.admin.table.course") %></th>
          <th class="py-3 px-4 text-left text-xs font-bold text-gray-500 uppercase"><%= t("dashboards.admin.table.category") %></th>
          <th class="py-3 px-4 text-left text-xs font-bold text-gray-500 uppercase"><%= t("dashboards.admin.table.term") %></th>
          <th class="py-3 px-4 text-left text-xs font-bold text-gray-500 uppercase"><%= t("dashboards.admin.table.registrations") %></th>
          <th class="py-3 px-4 text-right text-xs font-bold text-gray-500 uppercase"><%= t("dashboards.admin.table.action") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @courses.each do |course| %>
          <tr class="hover:bg-gray-50">
            <td class="py-4 px-4 font-bold text-gray-900 text-sm"><%= course.title %></td>
            <td class="py-4 px-4 text-sm text-gray-500"><%= course.registration_type_label %></td>
            <td class="py-4 px-4 text-sm text-gray-500"><%= course.term&.name || "–" %></td>
            <td class="py-4 px-4 text-sm font-medium text-primary-600"><%= course.occupied_spots %> <%= t("dashboards.admin.table.participants") %></td>
            <td class="py-4 px-4 text-right">
              <%= link_to t("dashboards.admin.table.manage"), manage_course_path(course), data: { turbo_frame: "_top" }, class: "text-slate-900 font-bold bg-white border border-slate-200 hover:bg-slate-50 px-3 py-1.5 rounded-full text-sm" %>
            </td>
          </tr>
        <% end %>
        <% if @courses.empty? %>
          <tr><td colspan="5" class="py-6 text-center text-sm text-gray-400"><%= t("dashboards.admin.table.no_results") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="text-center mt-4 mb-10 sm:mb-16">
    <% if @courses_total_count > @course_limit %>
      <%= link_to t("dashboards.admin.table.show_more"),
            dashboards_admin_path(course_q: params[:course_q], category: params[:category],
                                   registration_mode: params[:registration_mode], course_limit: @course_limit + 10),
            class: "inline-block bg-white border border-slate-200 hover:bg-gray-50 text-gray-700 font-bold py-2.5 px-6 rounded-full shadow-sm text-sm transition" %>
    <% end %>
  </div>
<% end %>
