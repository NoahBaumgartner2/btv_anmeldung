<%# ── Archiv: Kurse mit vergangenem Enddatum, gruppiert nach Zeitraum ──── %>
<% if @archived_courses_by_term.any? %>
  <details class="mb-10 sm:mb-16 group">
    <summary class="flex items-center gap-2 cursor-pointer list-none select-none text-sm font-bold text-gray-400 hover:text-gray-600 transition min-h-11">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
      <%= t("dashboards.admin.archive.title") %>
      <span class="font-normal text-gray-300">(<%= @archived_courses_by_term.sum { |_, courses| courses.size } %>)</span>
    </summary>

    <div class="mt-4 space-y-6">
      <% @archived_courses_by_term.each do |term, courses| %>
        <div class="bg-white shadow-sm ring-1 ring-slate-200/80 rounded-3xl overflow-hidden">
          <div class="px-4 py-2.5 bg-gray-50 border-b border-gray-100">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">
              <%= term&.name || t("dashboards.admin.archive.no_term") %>
            </p>
          </div>
          <ul class="divide-y divide-gray-100">
            <% courses.each do |course| %>
              <li class="flex items-center justify-between gap-3 px-4 py-3">
                <div class="min-w-0">
                  <p class="text-sm font-bold text-gray-700 truncate"><%= course.title %><%= " (deaktiviert)" if course.deactivated? %></p>
                  <p class="text-xs text-gray-400 mt-0.5">
                    <%= course.registration_type_label %>
                    <% if course.end_date.present? %>
                      &middot; <%= t("dashboards.admin.archive.ended", date: I18n.l(course.end_date.to_date)) %>
                    <% end %>
                  </p>
                </div>
                <%= link_to t("dashboards.admin.table.manage"), manage_course_path(course),
                      data: { turbo_frame: "_top" },
                      class: "shrink-0 text-slate-900 font-bold bg-white border border-slate-200 hover:bg-slate-50 px-3 py-1.5 rounded-full text-sm" %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </details>
<% end %>
