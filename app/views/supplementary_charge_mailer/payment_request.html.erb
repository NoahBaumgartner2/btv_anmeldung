<% primary = @_club&.effective_primary_color || "#dc2626" %>

<table width="100%" cellpadding="0" cellspacing="0" style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;margin-bottom:24px;">
  <tr>
    <td style="padding:16px 20px;">
      <p style="margin:0;font-size:15px;font-weight:600;color:#92400e;font-family:Arial,Helvetica,sans-serif;">Zusätzlicher Betrag fällig</p>
    </td>
  </tr>
</table>

<p style="margin:0 0 20px 0;font-size:15px;color:#374151;font-family:Arial,Helvetica,sans-serif;">
  Hallo <%= greeting_name(@recipient) %>,<br><br>
  für <strong><%= @participant.first_name %> <%= @participant.last_name %></strong> (<%= @course.title %>)
  verlangen wir nachträglich noch einen zusätzlichen Betrag von <strong><%= @charge.amount_display %></strong>.
</p>

<% if @charge.explanation.present? %>
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;margin-bottom:24px;">
    <tr>
      <td style="padding:20px;">
        <div style="font-size:15px;color:#111827;font-family:Arial,Helvetica,sans-serif;white-space:pre-line;"><%= simple_format(@charge.explanation, style: "margin:0;font-size:15px;color:#111827;font-family:Arial,Helvetica,sans-serif;") %></div>
      </td>
    </tr>
  </table>
<% end %>

<table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:32px;">
  <tr>
    <td align="center">
      <a href="<%= @charge_url %>"
         style="display:inline-block;background-color:<%= primary %>;color:#ffffff;text-decoration:none;padding:12px 28px;border-radius:8px;font-size:15px;font-weight:700;font-family:Arial,Helvetica,sans-serif;">
        Jetzt bezahlen &rarr;
      </a>
    </td>
  </tr>
</table>

<p style="margin:0 0 8px 0;font-size:13px;color:#6b7280;font-family:Arial,Helvetica,sans-serif;">
  Falls der Button nicht funktioniert, kopiere diesen Link in deinen Browser:
</p>
<p style="margin:0 0 24px 0;font-size:13px;color:#6b7280;word-break:break-all;font-family:Arial,Helvetica,sans-serif;">
  <%= @charge_url %>
</p>

<p style="margin:0;font-size:13px;color:#9ca3af;font-family:Arial,Helvetica,sans-serif;">
  Bei Fragen wende dich an den Administrator.
</p>
