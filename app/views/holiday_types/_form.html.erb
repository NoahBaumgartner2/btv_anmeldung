<%= form_with(model: holiday_type, class: "contents") do |form| %>
  <% if holiday_type.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
      <p class="font-semibold mb-1"><%= t('holidays.form.errors', count: holiday_type.errors.count) %></p>
      <ul class="list-disc ml-5 text-sm space-y-0.5">
        <% holiday_type.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-6">
    <%= form.label :name, t('holiday_types.form.label_name'), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.text_field :name,
          placeholder: t('holiday_types.form.placeholder_name'),
          class: ["block w-full rounded-lg border px-3 py-2.5 text-sm shadow-sm focus:outline-none focus:ring-2",
                  holiday_type.errors[:name].any? ? "border-red-400 focus:ring-red-400" : "border-gray-300 focus:ring-primary-500"] %>
    <% if holiday_type.errors[:name].any? %>
      <p class="mt-1 text-xs text-red-600"><%= holiday_type.errors[:name].first %></p>
    <% end %>
  </div>

  <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
    <%= form.submit holiday_type.new_record? ? t('holiday_types.form.save_new') : t('holiday_types.form.save_edit'),
          class: "w-full sm:w-auto rounded-lg px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold cursor-pointer transition shadow-sm" %>
    <%= link_to t('holidays.form.cancel'), holiday_types_path,
          class: "w-full sm:w-auto text-center rounded-lg px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium transition" %>
  </div>
<% end %>
