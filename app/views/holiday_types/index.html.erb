<% content_for :title, t('holiday_types.index.title') %>

<div class="max-w-4xl mx-auto mt-6 sm:mt-10 w-full mb-16 px-4">

  <%= render "admin/shared/section_header" %>

  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 sm:mb-8 gap-3 sm:gap-4">
    <div>
      <h2 class="text-xl sm:text-2xl font-bold text-gray-900"><%= t('holiday_types.index.title') %></h2>
      <p class="text-gray-500 mt-1 text-sm"><%= t('holiday_types.index.subtitle') %></p>
    </div>
    <%= link_to t('holiday_types.index.new_type'), new_holiday_type_path,
          class: "btn btn-primary shrink-0 w-full sm:w-auto min-h-11" %>
  </div>

  <% if @holiday_types.any? %>
    <div class="space-y-5">
      <% @holiday_types.each do |type| %>
        <div id="<%= dom_id(type) %>" class="scroll-mt-24 bg-white shadow-sm ring-1 ring-slate-200/80 rounded-3xl overflow-hidden">
          <div class="px-5 py-4 flex flex-wrap items-center justify-between gap-x-3 gap-y-1 bg-gray-50 border-b border-gray-100">
            <h2 class="font-bold text-gray-900"><%= type.name %></h2>
            <div class="flex items-center gap-3 shrink-0">
              <%= link_to t('holiday_types.index.edit_type'), edit_holiday_type_path(type),
                    class: "text-sm font-medium text-primary-600 hover:text-primary-800" %>
              <%= button_to t('holiday_types.index.delete_type'), holiday_type_path(type), method: :delete,
                    data: { turbo_confirm: t('holiday_types.index.delete_type_confirm', name: type.name) },
                    form: { class: "inline" },
                    class: "text-sm font-medium text-red-500 hover:text-red-700 cursor-pointer bg-transparent border-0 p-0" %>
            </div>
          </div>

          <%# Neueste 10 pro Ferienart; ältere über „Alle anzeigen“ (Liste wächst jedes Jahr). %>
          <% holidays = type.holidays.sort_by(&:start_date).reverse %>
          <% shown = params[:alle] == type.id.to_s ? holidays : holidays.first(10) %>
          <% if holidays.any? %>
            <ul class="divide-y divide-gray-100">
              <% shown.each do |holiday| %>
                <li class="px-5 py-3 flex items-center justify-between gap-3 text-sm">
                  <span class="font-medium text-gray-700">
                    <%= holiday.start_date.strftime("%-d. %b %Y") %> – <%= holiday.end_date.strftime("%-d. %b %Y") %>
                  </span>
                  <div class="flex items-center gap-3 shrink-0">
                    <%= link_to t('holiday_types.index.edit'), edit_holiday_type_holiday_path(type, holiday),
                          class: "text-primary-600 hover:text-primary-800 font-medium" %>
                    <%= button_to t('holiday_types.index.delete'), holiday_type_holiday_path(type, holiday), method: :delete,
                          data: { turbo_confirm: t('holiday_types.index.delete_confirm') },
                          form: { class: "inline" },
                          class: "text-red-500 hover:text-red-700 font-medium cursor-pointer bg-transparent border-0 p-0" %>
                  </div>
                </li>
              <% end %>
            </ul>
            <% if shown.size < holidays.size %>
              <div class="px-5 py-3 border-t border-gray-100 text-center">
                <%= link_to t("shared.load_more.show_all", count: holidays.size), holiday_types_path(alle: type.id, anchor: dom_id(type)),
                      class: "text-sm font-semibold text-primary-600 hover:text-primary-800" %>
              </div>
            <% end %>
          <% else %>
            <p class="px-5 py-4 text-sm text-gray-400"><%= t('holiday_types.index.no_dates') %></p>
          <% end %>

          <div class="px-5 py-3 bg-gray-50 border-t border-gray-100">
            <%= link_to t('holiday_types.index.add_date'), new_holiday_type_holiday_path(type),
                  class: "text-sm font-semibold text-primary-600 hover:text-primary-800" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white shadow-sm ring-1 ring-slate-200/80 rounded-3xl py-14 text-center">
      <p class="font-medium text-gray-700 mb-1"><%= t('holiday_types.index.empty.title') %></p>
      <p class="text-sm text-gray-400"><%= t('holiday_types.index.empty.body') %></p>
    </div>
  <% end %>

</div>
