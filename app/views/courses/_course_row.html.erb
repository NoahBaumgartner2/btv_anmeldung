<%# Kurszeile im Kategorie-Overlay der Kursübersicht (ohne Bild). Ganze Zeile
    führt zur Kursseite (Stretched Link am Titel); Maps-Link und Verwalten
    liegen mit z-10 darüber. locals: course, restricted %>
<%
  is_single = course.registration_mode == "single_session"
  is_full   = course.full?
  remaining = course.spots_remaining
  waitlist  = course.waitlist_count
  day_time  = course_day_and_time(course)
  cta_label = if is_single then t("courses.index.actions.view_dates")
              elsif is_full then t("courses.index.actions.join_waitlist")
              else t("courses.index.actions.register") end
%>
<article data-course-filter-target="card"
         data-weekdays="<%= course_weekdays(course).join(" ") %>"
         data-location="<%= course.location %>"
         class="group relative flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-5 rounded-2xl bg-white border border-slate-200/80 p-4 sm:p-5 transition-[box-shadow,border-color] duration-300 ease-entrance hover:border-slate-300 hover:shadow-lg focus-within:ring-2 focus-within:ring-slate-900">

  <%# ── Wann (wichtigster Entscheid) ── %>
  <div class="sm:w-40 shrink-0">
    <% if day_time %>
      <span class="sr-only"><%= course_weekly_time(course) %></span>
      <span class="inline-flex items-stretch rounded-xl overflow-hidden text-sm tabular-nums ring-1 ring-slate-900/10" aria-hidden="true">
        <span class="px-2.5 py-1.5 bg-slate-900 text-white font-bold"><%= day_time.first %></span>
        <span class="px-2.5 py-1.5 bg-white text-slate-900 font-semibold"><%= day_time.last %></span>
      </span>
    <% elsif is_single %>
      <span class="inline-flex rounded-xl bg-secondary-100 px-2.5 py-1.5 text-sm font-bold text-secondary-800"><%= t("courses.index.status.drop_in") %></span>
    <% end %>
  </div>

  <%# ── Was und Wo ── %>
  <div class="min-w-0 flex-1 space-y-1.5">
    <h3 class="text-base sm:text-lg font-extrabold text-slate-900 leading-snug break-words">
      <%= link_to course.title, course_path(course), class: "after:absolute after:inset-0 after:content-[''] focus:outline-none" %>
    </h3>
    <% if course.location.present? %>
      <p class="flex items-start gap-1.5 text-sm text-slate-600">
        <svg class="h-4 w-4 mt-0.5 shrink-0 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <span class="min-w-0">
          <span class="font-semibold text-slate-900"><%= course.location %></span>
          <% if course.location_address.present? %>
            ·
            <%= link_to course.location_address,
                  "https://www.google.com/maps/search/?api=1&query=#{URI.encode_www_form_component(course.location_address)}",
                  target: "_blank", rel: "noopener", title: t("courses.index.card.open_map"),
                  class: "relative z-10 underline decoration-slate-300 underline-offset-2 hover:text-slate-900 hover:decoration-slate-900" %>
          <% end %>
        </span>
      </p>
    <% end %>
    <p class="text-sm text-slate-500">
      <% if is_single %>
        <%= t("courses.index.date.single_session") %>
      <% elsif course.abo? %>
        <%= t("courses.index.date.abo") %>
      <% elsif course.start_date && course.end_date %>
        <%= l(course.start_date.to_date, format: "%-d. %b") %> – <%= l(course.end_date.to_date, format: "%-d. %b %Y") %>
      <% else %>
        <%= t("courses.index.date.tba") %>
      <% end %>
    </p>
    <div class="flex flex-wrap gap-1.5 pt-0.5">
      <% unless is_single %>
        <% if is_full %>
          <span class="inline-flex rounded-full bg-orange-100 px-2.5 py-0.5 text-xs font-bold text-orange-700"><%= t("courses.index.status.full") %></span>
        <% elsif remaining && remaining <= 3 %>
          <span class="inline-flex rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-bold text-amber-800"><%= t("courses.index.status.spots_last", count: remaining) %></span>
        <% elsif remaining %>
          <span class="inline-flex rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-bold text-green-700"><%= t("courses.index.status.spots_free", count: remaining) %></span>
        <% end %>
        <% if waitlist > 0 %>
          <span class="inline-flex rounded-full bg-orange-50 px-2.5 py-0.5 text-xs font-bold text-orange-700"><%= t("courses.index.status.waitlist", count: waitlist) %></span>
        <% end %>
      <% end %>
      <% if restricted %>
        <span class="inline-flex rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-bold text-red-700"><%= t("courses.index.restricted_badge") %></span>
      <% end %>
      <% if course.age_restricted? %>
        <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-bold text-slate-600"><%= course.age_range_label %></span>
      <% end %>
    </div>
  </div>

  <%# ── Preis und Aktion ── %>
  <div class="flex flex-wrap sm:flex-col items-center sm:items-end justify-between gap-2 shrink-0">
    <span class="text-lg font-extrabold text-slate-900 whitespace-nowrap tabular-nums">
      <% if course.late_registration_deduction_cents.positive? %>
        <span class="block text-xs font-semibold text-slate-400 line-through"><%= course.price_display %></span>
      <% end %>
      <%= course.effective_price_display %>
    </span>
    <div class="flex items-center gap-2">
      <% if current_user&.admin? %>
        <%= link_to t("courses.index.actions.manage"), manage_course_path(course),
              class: "relative z-10 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-900 hover:bg-slate-50 transition-colors" %>
      <% end %>
      <span class="inline-flex items-center gap-1 whitespace-nowrap rounded-full px-3.5 py-2 text-sm font-semibold text-white <%= is_full && !is_single ? "bg-orange-500" : "bg-slate-900" %>" aria-hidden="true">
        <%= cta_label %>
        <svg class="h-4 w-4 transition-transform duration-300 ease-entrance group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
      </span>
    </div>
  </div>
</article>
