<%= form_with(model: course, class: "contents", data: { controller: "scroll-to-error registration-mode" }) do |form| %>
  <% if course.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 px-5 py-4 mb-6" data-error-scroll-target>
      <p class="text-sm font-bold text-red-800 mb-2"><%= course.errors.count %> Fehler:</p>
      <ul class="list-disc list-inside text-sm text-red-700 space-y-0.5">
        <% course.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# ── 1. Benennung & Kategorie ──────────────────────────────────────────── %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-5">
    <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">Benennung &amp; Kategorie</p>
    </div>
    <div class="p-6 space-y-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <%= form.label :category, "Kategorie", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <p class="text-xs text-gray-400 mb-1.5">z.B. Kids Gym, Krabbel Gym — gleiche Kategorie wird auf der Startseite gruppiert.</p>
          <%= form.text_field :category,
                placeholder: "z.B. Kids Gym",
                class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
        </div>
        <div>
          <%= form.label :title, "Kursname", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <p class="text-xs text-gray-400 mb-1.5">Vollständiger Name des Kurses, z.B. Kids Gym (Mittwoch Morgen).</p>
          <%= form.text_field :title,
                placeholder: "z.B. Kids Gym (Mittwoch Morgen)",
                class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
        </div>
      </div>
      <div>
        <%= form.label :description, "Kursbeschreibung", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_area :description,
              rows: 3,
              class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      </div>
    </div>
  </div>

  <%# ── 2. Zeitraum & Ort ─────────────────────────────────────────────────── %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-5">
    <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">Zeitraum &amp; Ort</p>
    </div>
    <div class="p-6">
      <div id="course-date-fields"
           data-registration-mode-target="dateFields"
           data-controller="term-mode"
           class="mb-5">
        <div class="flex gap-5 mb-4">
          <label class="flex items-center gap-2 cursor-pointer">
            <%= radio_button_tag "course[term_mode]", "term", course.term_id.present? || course.new_record?,
                  data: { term_mode_target: "radio", action: "change->term-mode#toggle" },
                  class: "h-4 w-4 text-primary-600 border-gray-300 focus:ring-primary-500 cursor-pointer" %>
            <span class="text-sm font-medium text-gray-800">Semester/Quartal</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <%= radio_button_tag "course[term_mode]", "manual", course.persisted? && course.term_id.blank?,
                  data: { term_mode_target: "radio", action: "change->term-mode#toggle" },
                  class: "h-4 w-4 text-primary-600 border-gray-300 focus:ring-primary-500 cursor-pointer" %>
            <span class="text-sm font-medium text-gray-800">Eigener Zeitraum</span>
          </label>
        </div>

        <div data-term-mode-target="termFields">
          <%= form.label :term_id, "Semester/Quartal", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <p class="text-xs text-gray-400 mb-1.5">
            Ordnet den Kurs einem Datumsbereich (z.B. HS2026) zu. Start-/Enddatum werden vom Term übernommen.
            Sobald der Vorlauf (im Term hinterlegtes Datum "Vorlauf für Angemeldete") erreicht ist, wird
            automatisch ein Nachfolge-Kurs für den nächsten Term derselben Art erstellt (gleiche Einstellungen,
            neue Trainings – Wochentag/Zeit werden von den bestehenden Trainings übernommen).
          </p>
          <%= form.select :term_id,
                options_for_select(
                  Term.order(start_date: :desc).map { |t| [ t.name, t.id, { data: { start: t.start_date, end: t.end_date } } ] },
                  course.term_id
                ),
                { include_blank: "Kein Semester/Quartal" },
                data: { term_mode_target: "termSelect", action: "change->term-mode#syncDates" },
                class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11 mb-5" %>

          <div class="mb-5">
            <%= form.label :public_registration_days, "Vorlauf für alle (Tage)", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <p class="text-xs text-gray-400 mb-1.5">So viele Tage nach dem im Term hinterlegten Vorlauf-Datum wird die Anmeldung für alle geöffnet.</p>
            <%= form.number_field :public_registration_days, min: 0,
                  class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
          </div>

          <label class="flex items-center gap-3 cursor-pointer">
            <%= form.check_box :auto_rollover,
                  class: "h-5 w-5 text-primary-600 rounded border-gray-300 focus:ring-primary-500 cursor-pointer shrink-0" %>
            <span class="text-sm font-medium text-gray-800">Nächste Periode automatisch erstellen</span>
          </label>
          <p class="text-xs text-gray-400 mt-0.5 ml-8">
            Aus: sobald der Vorlauf erreicht ist, bekommen Admins nur eine E-Mail und können die Verlängerung
            über einen Button in der Kursverwaltung selbst auslösen.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5" data-term-mode-target="manualFields">
          <div>
            <%= form.label :start_date, "Startdatum", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.date_field :start_date,
                  data: { controller: "datepicker", term_mode_target: "startDate" },
                  class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
          </div>
          <div>
            <%= form.label :end_date, "Enddatum", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.date_field :end_date,
                  data: { controller: "datepicker", term_mode_target: "endDate" },
                  class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
          </div>
        </div>
      </div>
      <div id="course-abo-hint"
           data-registration-mode-target="aboDateHint"
           class="hidden mb-5 p-3 bg-emerald-50 border border-emerald-200 rounded-lg text-sm text-emerald-800">
        Abo-Kurse sind durchgehend verfügbar – Start-/Enddatum entfallen.
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <%= form.label :location, "Halle / Ort", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <p class="text-xs text-gray-400 mb-1.5">Kurzbezeichnung, z.B. Turnhalle BTV – wird auf der Kursseite angezeigt.</p>
          <%= form.text_field :location,
                placeholder: "z.B. Turnhalle BTV",
                class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
        </div>
        <div>
          <%= form.label :location_address, "Adresse (Navigation)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <p class="text-xs text-gray-400 mb-1.5">Vollständige Adresse für Google Maps, z.B. Musterstrasse 12, 3000 Bern. Optional.</p>
          <%= form.text_field :location_address,
                placeholder: "z.B. Musterstrasse 12, 3000 Bern",
                class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
        </div>
      </div>
    </div>
  </div>

  <%# ── 3. Trainingszeit ──────────────────────────────────────────────────── %>
  <% hours   = (6..22).map { |h| [format("%02d", h), h] } %>
  <% minutes = (0..55).step(5).map { |m| [format("%02d", m), m] } %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-5">
    <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">Trainingszeit</p>
    </div>
    <div class="p-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <p class="text-sm font-medium text-gray-700 mb-2">Beginn</p>
          <div class="flex items-center gap-2">
            <select name="course[default_start_hour]"
                    class="flex-1 min-w-0 rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white min-h-11">
              <option value="">Std.</option>
              <% hours.each do |label, val| %>
                <option value="<%= val %>" <%= "selected" if course.default_start_hour == val %>><%= label %></option>
              <% end %>
            </select>
            <span class="text-gray-500 font-bold shrink-0">:</span>
            <select name="course[default_start_minute]"
                    class="flex-1 min-w-0 rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white min-h-11">
              <% minutes.each do |label, val| %>
                <option value="<%= val %>" <%= "selected" if course.default_start_minute == val %>><%= label %></option>
              <% end %>
            </select>
            <span class="text-sm text-gray-400 shrink-0">Uhr</span>
          </div>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-700 mb-2">Ende</p>
          <div class="flex items-center gap-2">
            <select name="course[default_end_hour]"
                    class="flex-1 min-w-0 rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white min-h-11">
              <option value="">Std.</option>
              <% hours.each do |label, val| %>
                <option value="<%= val %>" <%= "selected" if course.default_end_hour == val %>><%= label %></option>
              <% end %>
            </select>
            <span class="text-gray-500 font-bold shrink-0">:</span>
            <select name="course[default_end_minute]"
                    class="flex-1 min-w-0 rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white min-h-11">
              <% minutes.each do |label, val| %>
                <option value="<%= val %>" <%= "selected" if course.default_end_minute == val %>><%= label %></option>
              <% end %>
            </select>
            <span class="text-sm text-gray-400 shrink-0">Uhr</span>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-6 border-t border-gray-100">
          <p class="text-sm font-bold text-gray-700 mb-1">Trainings automatisch erstellen</p>
          <p class="text-xs text-gray-400 mb-3">
            <% if course.new_record? %>
              Wochentag(e) wählen – beim Speichern werden die einzelnen Trainingstermine im gewählten
              Zeitraum automatisch angelegt (Ferien werden übersprungen).
            <% else %>
              Wochentag(e) wählen – beim Speichern werden fehlende Trainingstermine im gewählten Zeitraum
              automatisch ergänzt (bereits vorhandene Termine und Ferien werden übersprungen).
            <% end %>
          </p>

          <div class="flex gap-2 flex-wrap mb-5">
            <% [ [ "Mo", 1 ], [ "Di", 2 ], [ "Mi", 3 ], [ "Do", 4 ], [ "Fr", 5 ], [ "Sa", 6 ], [ "So", 0 ] ].each do |label, value| %>
              <label class="cursor-pointer">
                <input type="checkbox" name="weekdays[]" value="<%= value %>" class="sr-only peer" id="new_weekday_<%= value %>">
                <span class="peer-checked:bg-primary-600 peer-checked:text-white peer-checked:border-primary-600
                             block border-2 border-gray-200 bg-gray-50 text-gray-700 hover:border-primary-300
                             font-bold px-4 py-2.5 rounded-xl text-sm transition select-none w-14 text-center">
                  <%= label %>
                </span>
              </label>
            <% end %>
          </div>

          <% if HolidayType.any? %>
            <p class="text-sm font-bold text-gray-700 mb-1">Ferien überspringen</p>
            <p class="text-xs text-gray-400 mb-2">
              Die genauen Jahres-Daten pro Typ werden unter
              <%= link_to "Ferien-Verwaltung", holiday_types_path, target: "_blank", class: "underline" %> gepflegt.
            </p>
            <div class="flex gap-2 flex-wrap mb-5">
              <%= hidden_field_tag "course[holiday_type_ids][]", "" %>
              <% HolidayType.order(:name).each do |type| %>
                <label class="cursor-pointer">
                  <input type="checkbox" name="course[holiday_type_ids][]" value="<%= type.id %>"
                         <%= "checked" if course.new_record? || course.holiday_type_ids.include?(type.id) %> class="sr-only peer">
                  <span class="peer-checked:bg-primary-600 peer-checked:text-white peer-checked:border-primary-600
                               block border-2 border-gray-200 bg-gray-50 text-gray-700 hover:border-primary-300
                               font-semibold px-4 py-2 rounded-xl text-sm transition select-none">
                    <%= type.name %>
                  </span>
                </label>
              <% end %>
            </div>
          <% end %>

          <div data-controller="extra-holidays">
            <p class="text-sm font-bold text-gray-700 mb-2">
              Weitere Ferien <span class="font-normal text-gray-400">(optional)</span>
            </p>
            <div data-extra-holidays-target="list" class="space-y-2"></div>
            <button type="button" data-action="extra-holidays#addHoliday"
                    class="mt-3 flex items-center gap-1.5 text-sm font-semibold text-primary-600 hover:text-primary-800 transition">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
              </svg>
              Ferien hinzufügen
            </button>
          </div>
        </div>
    </div>
  </div>

  <%# ── 4. Anmeldemodus & Kapazität ───────────────────────────────────────── %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-5">
    <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">Anmeldemodus &amp; Kapazität</p>
    </div>
    <div class="p-6 space-y-5"
         data-action="change->registration-mode#toggle">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <%= form.label :registration_mode, "Anmeldemodus", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.select :registration_mode,
                [["Semester (einmalige Anmeldung pro Semester)", "semester"],
                 ["Jahreskurs (einmalige Anmeldung pro Jahr)", "jahreskurs"],
                 ["Quartal (einmalige Anmeldung pro Quartal)", "quartal"],
                 ["Abo (Kontingent, z.B. 10er-Abo)", "abo"],
                 ["Drop-In / Einzeltraining (pro Training)", "single_session"]],
                { prompt: "Bitte wählen…" },
                id: "course_registration_mode",
                class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
        </div>
        <div>
          <%= form.label :max_participants, "Max. Teilnehmerzahl", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.number_field :max_participants,
                min: 1, placeholder: "z.B. 20",
                class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
          <p class="mt-1 text-xs text-gray-400">Bei Drop-In-Kursen der Standardwert - pro Training in dessen Bearbeitung überschreibbar.</p>
        </div>
      </div>

      <div class="mt-4 flex items-start gap-3">
        <%= form.check_box :enable_waitlist,
              class: "h-5 w-5 mt-0.5 text-primary-600 rounded border-gray-300 focus:ring-primary-500 cursor-pointer shrink-0" %>
        <div>
          <%= form.label :enable_waitlist, "Warteliste aktivieren", class: "text-sm font-medium text-gray-800 cursor-pointer block" %>
          <p class="text-xs text-gray-400 mt-0.5">Wenn der Kurs voll ist, landen neue Anmeldungen automatisch auf der Warteliste.</p>
        </div>
      </div>

      <div class="mt-4 flex items-start gap-3">
        <%= form.check_box :grants_abo_makeup_entry,
              class: "h-5 w-5 mt-0.5 text-primary-600 rounded border-gray-300 focus:ring-primary-500 cursor-pointer shrink-0" %>
        <div>
          <%= form.label :grants_abo_makeup_entry, "Ausgleichs-Abo-Eintritt bei Trainingsabmeldung", class: "text-sm font-medium text-gray-800 cursor-pointer block" %>
          <p class="text-xs text-gray-400 mt-0.5">Meldet sich jemand von einem einzelnen Training ab, wird automatisch ein kostenloser Einzeleintritt im Abo derselben Kategorie gutgeschrieben (bestehendes Abo +1, sonst neues 1er-Abo).</p>
        </div>
      </div>

      <div class="mt-4 flex items-start gap-3">
        <%= form.check_box :allows_trainer_self_enroll,
              class: "h-5 w-5 mt-0.5 text-primary-600 rounded border-gray-300 focus:ring-primary-500 cursor-pointer shrink-0" %>
        <div>
          <%= form.label :allows_trainer_self_enroll, "Gratis-Selbstanmeldung für Trainer erlauben", class: "text-sm font-medium text-gray-800 cursor-pointer block" %>
          <p class="text-xs text-gray-400 mt-0.5">Trainer können sich für diesen Kurs kostenlos selbst anmelden (Altersbeschränkung gilt weiterhin). Zusätzlich über den globalen Schalter im Admin-Dashboard steuerbar.</p>
        </div>
      </div>

      <%# Abo-Grösse – nur sichtbar wenn Anmeldemodus = abo %>
      <div id="abo-size-field"
           data-registration-mode-target="aboField"
           class="<%= course.registration_mode == 'abo' ? '' : 'hidden' %> mt-4">
        <%= form.label :abo_size, "Anzahl Eintritte pro Abo", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <p class="text-xs text-gray-400 mb-1.5">z.B. 10 für ein 10er-Abo, 5 für ein 5er-Abo.</p>
        <%= form.number_field :abo_size, min: 1, placeholder: "10",
              class: "block w-max rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
      </div>

      <%# Altersbeschränkung %>
      <div class="border-t border-gray-100 pt-5">
        <p class="text-sm font-medium text-gray-700 mb-0.5">Altersbeschränkung <span class="font-normal text-gray-400">(optional)</span></p>
        <p class="text-xs text-gray-400 mb-3">Leer lassen = keine Einschränkung. Das Alter wird anhand des Kursstarts berechnet.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <%= form.label :min_age, "Mindestalter", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <div class="flex items-center gap-2">
              <%= form.number_field :min_age,
                    min: 0, max: 120, placeholder: "z.B. 3",
                    class: "flex-1 min-w-0 rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
              <span class="text-sm text-gray-400 shrink-0">Jahre</span>
            </div>
          </div>
          <div>
            <%= form.label :max_age, "Höchstalter", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <div class="flex items-center gap-2">
              <%= form.number_field :max_age,
                    min: 0, max: 120, placeholder: "z.B. 5",
                    class: "flex-1 min-w-0 rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
              <span class="text-sm text-gray-400 shrink-0">Jahre</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ── 5. Trainer-Zuweisung ──────────────────────────────────────────────── %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-5">
    <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">Trainer-Zuweisung</p>
    </div>
    <div class="p-6">
      <% if Trainer.any? %>
        <p class="text-sm text-gray-500 mb-4">Wähle aus, welche Trainer diesen Kurs verwalten dürfen, und ob sie Kinder manuell anmelden dürfen.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" data-controller="trainer-permission">
          <% Trainer.includes(:user).order("users.email").each do |trainer| %>
            <%
              course_trainer = course.course_trainers.find { |ct| ct.trainer_id == trainer.id }
              is_assigned    = course_trainer.present?
              can_enroll     = course_trainer&.can_manually_enroll? || false
            %>
            <div class="border border-gray-200 rounded-xl p-4 bg-gray-50">
              <label class="flex items-center gap-3 cursor-pointer mb-3">
                <%= check_box_tag "course[trainer_ids][]",
                      trainer.id,
                      is_assigned,
                      id: "trainer_#{trainer.id}",
                      class: "h-5 w-5 text-primary-600 rounded border-gray-300 focus:ring-primary-500 cursor-pointer shrink-0",
                      data: { action: "change->trainer-permission#togglePermission",
                              "trainer-id": trainer.id } %>
                <span class="text-sm font-semibold text-gray-800 truncate"><%= trainer.user.email %></span>
              </label>
              <div id="trainer-perms-<%= trainer.id %>" class="<%= is_assigned ? '' : 'hidden' %> ml-8">
                <label class="flex items-center gap-2 cursor-pointer">
                  <%= check_box_tag "course[trainer_permissions][#{trainer.id}][can_manually_enroll]",
                        "1",
                        can_enroll,
                        class: "h-4 w-4 text-primary-600 rounded border-gray-300 focus:ring-primary-500 cursor-pointer" %>
                  <span class="text-xs font-medium text-gray-600">Darf Kinder manuell zum Kurs hinzufügen</span>
                </label>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500">Noch keine Trainer angelegt.</p>
      <% end %>

      <%# Neuen Trainer direkt anlegen %>
      <div class="mt-4 border-t border-gray-100 pt-4">
        <details class="group">
          <summary class="text-sm font-semibold text-primary-600 hover:text-primary-800 cursor-pointer list-none flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-open:rotate-90 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
            Neuen Trainer direkt erfassen
          </summary>
          <div class="mt-4 bg-gray-50 rounded-lg border border-gray-200 p-4 space-y-3">
            <p class="text-xs text-gray-500">Erstellt einen neuen Trainer-Account und weist ihn sofort diesem Kurs zu. Der Trainer erhält eine E-Mail zum Passwort setzen.</p>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">E-Mail-Adresse des Trainers</label>
              <input type="email" name="new_trainer_email"
                     placeholder="trainer@beispiel.ch"
                     class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Telefon <span class="font-normal text-gray-400">(optional)</span></label>
              <input type="tel" name="new_trainer_phone"
                     placeholder="+41 79 123 45 67"
                     class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11">
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>

  <%# ── 6. Weitere Einstellungen ──────────────────────────────────────────── %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-5">
    <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">Weitere Einstellungen</p>
    </div>
    <div class="p-6 space-y-5">

      <%# Kursgebühr %>
      <div data-controller="payment-toggle"
           data-action="change->payment-toggle#toggle">
        <p class="text-sm font-medium text-gray-700 mb-2">Kursgebühr</p>
        <div class="flex gap-4">
          <label class="flex items-center gap-2 cursor-pointer">
            <%= form.radio_button :has_payment, false, id: "has_payment_false",
                  class: "h-4 w-4 text-primary-600 border-gray-300 focus:ring-primary-500 cursor-pointer",
                  checked: !course.has_payment? %>
            <span class="text-sm font-medium text-gray-800">Kostenlos</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <%= form.radio_button :has_payment, true, id: "has_payment_true",
                  class: "h-4 w-4 text-primary-600 border-gray-300 focus:ring-primary-500 cursor-pointer",
                  checked: course.has_payment? %>
            <span class="text-sm font-medium text-gray-800">Kostenpflichtig</span>
          </label>
        </div>

        <div id="price-field" data-payment-toggle-target="priceField"
             class="<%= course.has_payment? ? "" : "hidden" %> mt-4 ml-2 space-y-4">
          <div>
            <p class="text-sm font-medium text-gray-700 mb-1">Preis</p>
            <div class="flex items-center gap-2 max-w-xs">
              <span class="text-sm font-semibold text-gray-500 shrink-0">CHF</span>
              <%= form.text_field :price_chf,
                    placeholder: "0.00",
                    class: "flex-1 rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
            </div>
            <p class="text-xs text-gray-400 mt-1">Preis in Schweizer Franken (z.B. 120.00)</p>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-700 mb-1">Jugendpreis <span class="font-normal text-gray-400">(optional)</span></p>
            <div class="flex items-center gap-2 max-w-xs">
              <span class="text-sm font-semibold text-gray-500 shrink-0">CHF</span>
              <%= form.text_field :youth_price_chf,
                    placeholder: "0.00",
                    class: "flex-1 rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
            </div>
            <p class="text-xs text-gray-400 mt-1">Reduzierter Preis für junge Teilnehmende (z.B. 250.00). Leer lassen = kein Jugendpreis.</p>
            <div class="mt-3 flex items-center gap-2 max-w-xs">
              <%= form.label :youth_max_age, "Bis und mit Alter", class: "text-sm font-medium text-gray-700 shrink-0" %>
              <%= form.number_field :youth_max_age, min: 0, max: 120, placeholder: "20",
                    class: "w-24 rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
              <span class="text-sm text-gray-400">Jahre</span>
            </div>
            <p class="text-xs text-gray-400 mt-1">Alter wird zum Kursstart berechnet.</p>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-700 mb-1">Wert pro Training</p>
            <div class="flex items-center gap-2 max-w-xs">
              <span class="text-sm font-semibold text-gray-500 shrink-0">CHF</span>
              <%= form.text_field :training_value_chf,
                    placeholder: "0.00",
                    class: "flex-1 rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
            </div>
            <p class="text-xs text-gray-400 mt-1">Wird für automatische Rückerstattungen bei Abmeldung verwendet (z.B. 15.00)</p>
          </div>

          <div class="pt-4 border-t border-gray-100 flex items-start gap-3">
            <%= form.check_box :allows_late_registration_deduction,
                  class: "h-5 w-5 mt-0.5 text-primary-600 rounded border-gray-300 focus:ring-primary-500 cursor-pointer shrink-0" %>
            <div>
              <%= form.label :allows_late_registration_deduction, "Späteres Anmelden mit Preisreduktion erlauben", class: "text-sm font-medium text-gray-800 cursor-pointer block" %>
              <p class="text-xs text-gray-400 mt-0.5">Wer erst einsteigt, nachdem der Kurs schon läuft, zahlt weniger: Das erste bereits stattgefundene Training zählt noch normal, ab jedem weiteren wird "Wert pro Training" abgezogen.</p>
            </div>
          </div>

          <%# Preisreduktion (Geschwister / Zweitkurs) %>
          <div class="pt-4 border-t border-gray-100" data-controller="discount-toggle">
            <label class="flex items-center gap-3 cursor-pointer">
              <%= form.check_box :discounts_enabled,
                    class: "h-5 w-5 text-primary-600 rounded border-gray-300 focus:ring-primary-500 cursor-pointer shrink-0",
                    data: { "discount-toggle-target": "checkbox", action: "change->discount-toggle#toggle" } %>
              <span class="text-sm font-medium text-gray-800">Preisreduktion aktivieren</span>
            </label>
            <div data-discount-toggle-target="fields"
                 class="<%= course.discounts_enabled? ? "" : "hidden" %> mt-4 ml-8 space-y-4">
              <div>
                <p class="text-sm font-medium text-gray-700 mb-1">Reduzierter Preis für 2. Kind der Familie</p>
                <div class="flex items-center gap-2 max-w-xs">
                  <span class="text-sm font-semibold text-gray-500 shrink-0">CHF</span>
                  <%= form.text_field :sibling_price_chf,
                        placeholder: "0.00",
                        class: "flex-1 rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
                </div>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-700 mb-1">Reduzierter Preis bei 2. Kurs derselben Person</p>
                <div class="flex items-center gap-2 max-w-xs">
                  <span class="text-sm font-semibold text-gray-500 shrink-0">CHF</span>
                  <%= form.text_field :second_course_price_chf,
                        placeholder: "0.00",
                        class: "flex-1 rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 min-h-11" %>
                </div>
              </div>
              <p class="text-xs text-gray-400">Die Reduktion gilt innerhalb derselben Trainingskategorie und nur für die neue Anmeldung. Treffen beide Fälle zu, wird automatisch der günstigere Preis angewendet.</p>
            </div>
          </div>
        </div>

      </div>

      <div class="border-t border-gray-100 pt-5 space-y-4">
        <%# Ticketing %>
        <label class="flex items-center gap-3 cursor-pointer">
          <%= form.check_box :has_ticketing,
                class: "h-5 w-5 text-primary-600 rounded border-gray-300 focus:ring-primary-500 cursor-pointer shrink-0" %>
          <span class="text-sm font-medium text-gray-800">Ticketing / QR-Codes für diesen Kurs aktivieren</span>
        </label>

        <%# J+S %>
        <div>
          <label class="flex items-center gap-3 cursor-pointer">
            <%= form.check_box :is_js_training,
                  class: "h-5 w-5 text-primary-600 rounded border-gray-300 focus:ring-primary-500 cursor-pointer shrink-0" %>
            <span class="text-sm font-medium text-gray-800">Dies ist ein J+S-Training</span>
          </label>
          <p class="text-xs text-gray-400 mt-1 ml-8">Aktiviere diese Option, wenn der Kurs bei Jugend+Sport (BASPO) gemeldet wird.</p>
        </div>

        <%# Leistungssport / restricted %>
        <div class="pt-2 border-t border-gray-100">
          <label class="flex items-center gap-3 cursor-pointer">
            <%= form.check_box :restricted,
                  class: "h-5 w-5 text-red-600 rounded border-gray-300 focus:ring-red-500 cursor-pointer shrink-0" %>
            <span class="text-sm font-medium text-gray-800"><%= t("courses.form.restricted_label") %></span>
          </label>
          <p class="text-xs text-gray-400 mt-1 ml-8">Kurs ist nur für eingeladene Benutzer sichtbar und buchbar. Zugänge werden in der Kursverwaltung vergeben.</p>
        </div>

        <%# Admin-Benachrichtigung bei Profiländerung %>
        <div class="pt-2 border-t border-gray-100">
          <label class="flex items-center gap-3 cursor-pointer">
            <%= form.check_box :notify_admin_on_participant_profile_change,
                  class: "h-5 w-5 text-primary-600 rounded border-gray-300 focus:ring-primary-500 cursor-pointer shrink-0" %>
            <span class="text-sm font-medium text-gray-800">Admin benachrichtigen, wenn ein angemeldeter Teilnehmer sein Profil ändert</span>
          </label>
          <p class="text-xs text-gray-400 mt-1 ml-8">Z.B. Adresse, Telefonnummer o.Ä. Betrifft nur Teilnehmer, die für diesen Kurs angemeldet sind. Kann in der Benachrichtigungszentrale und unter "Meine Benachrichtigungen" zusätzlich ein-/ausgeschaltet werden.</p>
        </div>
      </div>
    </div>
  </div>

  <%# ── 7. Pflichtangaben bei Anmeldung ───────────────────────────────────── %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">Pflichtangaben bei Anmeldung</p>
    </div>
    <div class="p-6">
      <p class="text-sm text-gray-500 mb-4">Welche Angaben müssen Teilnehmende zusätzlich zu Vorname, Nachname, Geburtsdatum und Geschlecht zwingend hinterlegt haben?</p>
      <div class="space-y-3">
        <% Course::CONFIGURABLE_REQUIRED_FIELDS.each do |field, label| %>
          <%
            hints = {
              ahv_number:       "Wird für die Meldung ans Amt für Sport benötigt.",
              js_person_number: "Wird für die BASPO J+S Meldung benötigt.",
              nationality:      "Wird für die BASPO J+S Meldung benötigt.",
              mother_tongue:    "Wird für die BASPO J+S Meldung benötigt.",
              zip_code:         "Wird für die BASPO J+S Meldung benötigt.",
              city:             "Wird für die BASPO J+S Meldung benötigt.",
              country:          "Wird für die BASPO J+S Meldung benötigt.",
              street:           "Wird für die BASPO J+S Meldung benötigt."
            }
          %>
          <div class="flex items-start gap-3">
            <%= form.check_box :"requires_#{field}",
                  class: "h-5 w-5 mt-0.5 text-primary-600 rounded border-gray-300 focus:ring-primary-500 cursor-pointer shrink-0" %>
            <div>
              <%= form.label :"requires_#{field}", label, class: "text-sm font-medium text-gray-800 cursor-pointer block" %>
              <p class="text-xs text-gray-400 mt-0.5"><%= hints[field] %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# ── Schnuppern ──────────────────────────────────────────────────────── %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">Schnuppern</p>
    </div>
    <div class="p-6">
      <p class="text-sm text-gray-500 mb-4">Familien können einmalig pro Trainingskategorie kostenlos schnuppern. Identifikation erfolgt via AHV-Nummer (falls Pflichtfeld) oder Vorname, Nachname und Geburtsdatum.</p>
      <div class="flex items-start gap-3">
        <%= form.check_box :allows_trial,
              class: "h-5 w-5 mt-0.5 text-primary-600 rounded border-gray-300 focus:ring-primary-500 cursor-pointer shrink-0" %>
        <div>
          <%= form.label :allows_trial, "Schnuppern erlauben", class: "text-sm font-medium text-gray-800 cursor-pointer block" %>
          <p class="text-xs text-gray-400 mt-0.5">Familien sehen einen "Jetzt schnuppern"-Button, wenn sie noch nie in dieser Kategorie geschnuppert haben. Identifikation via AHV-Nummer (falls vorhanden) oder Vorname, Nachname &amp; Geburtsdatum.</p>
        </div>
      </div>

      <div class="mt-4 pt-4 border-t border-gray-100 flex items-start gap-3">
        <%= form.check_box :allows_talent_marking,
              class: "h-5 w-5 mt-0.5 text-primary-600 rounded border-gray-300 focus:ring-primary-500 cursor-pointer shrink-0" %>
        <div>
          <%= form.label :allows_talent_marking, "Talentmarkierung aktivieren", class: "text-sm font-medium text-gray-800 cursor-pointer block" %>
          <p class="text-xs text-gray-400 mt-0.5">Leiter*innen können Teilnehmende als Talent markieren. Sichtbar nur für Kursleitung und Admin.</p>
        </div>
      </div>
    </div>
  </div>

  <%# ── Zusatzinfo für die Bestätigungs-E-Mail ─────────────────────────────── %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-5">
    <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">Zusatzinfo für die Bestätigungs-E-Mail</p>
    </div>
    <div class="p-6">
      <%= form.label :email_note, "Zusätzliche Informationen", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_area :email_note, rows: 4,
            placeholder: "z.B. Türcode 1234, Eingang Seitentür, bitte rutschfeste Socken mitbringen …",
            class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      <p class="text-xs text-gray-400 mt-1">Dieser Text erscheint unten in der Anmeldebestätigung an die Teilnehmenden. Leer lassen = kein Zusatztext.</p>
    </div>
  </div>

  <%# ── Aktionen ───────────────────────────────────────────────────────────── %>
  <div class="flex flex-col sm:flex-row gap-3">
    <%= form.submit course.new_record? ? t("courses.form.submit_create") : t("courses.form.submit_update"),
          class: "w-full sm:w-auto cursor-pointer bg-primary-600 hover:bg-primary-700 active:bg-primary-800 text-white font-bold py-2.5 px-6 rounded-xl shadow-sm text-sm transition min-h-11" %>
    <%= link_to t("courses.form.cancel"), course.new_record? ? courses_path : manage_course_path(course),
          class: "w-full sm:w-auto text-center bg-gray-100 hover:bg-gray-200 active:bg-gray-300 text-gray-700 font-bold py-2.5 px-6 rounded-xl text-sm transition min-h-11 flex items-center justify-center" %>
  </div>
<% end %>
