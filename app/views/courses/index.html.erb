<% content_for :title, t("courses.index.title") %>
<%
  groups = ->(courses) { courses.group_by(&:category_name).sort }
  all_courses = @restricted_courses + @public_courses
  filter_days = all_courses.flat_map { |c| course_weekdays(c) }.uniq.sort_by { |d| (d - 1) % 7 }
  filter_locations = all_courses.map(&:location).compact_blank.uniq.sort
%>

<div class="max-w-6xl mx-auto w-full" data-controller="course-filter">

  <%# ── Kopf ───────────────────────────────────────────────────────────── %>
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-6 gap-4">
    <div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight"><%= t("courses.index.title") %></h1>
      <p class="text-slate-600 mt-1 text-sm sm:text-base"><%= t("courses.index.subtitle") %></p>
    </div>
    <% if current_user&.admin? %>
      <%= link_to t("courses.index.new_course"), new_course_path, class: "btn btn-primary w-full sm:w-auto" %>
    <% end %>
  </div>

  <%# ── Filter Wann & Wo (läuft beim Scrollen mit) ─────────────────────── %>
  <% if filter_days.size > 1 || filter_locations.size > 1 %>
    <div class="lg:sticky lg:top-4 z-20 mb-8 glass-strong rounded-2xl p-2.5 sm:p-3 space-y-2">
      <% [ [ :weekday, filter_days, ->(d) { t("date.abbr_day_names")[d] } ],
           [ :location, filter_locations, ->(l) { l } ] ].each do |key, values, label| %>
        <% next if values.size < 2 %>
        <div class="flex items-center gap-2 overflow-x-auto [scrollbar-width:none] -mx-1 px-1" role="group" aria-label="<%= t("courses.index.filter.#{key}") %>">
          <span class="shrink-0 w-10 text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("courses.index.filter.#{key}_short") %></span>
          <% values.each do |v| %>
            <button type="button" class="chip" aria-pressed="false"
                    data-course-filter-target="chip" data-key="<%= key %>" data-value="<%= v %>"
                    data-action="course-filter#toggle"><%= label.call(v) %></button>
          <% end %>
        </div>
      <% end %>
      <div class="flex items-center justify-between gap-3 px-1" data-course-filter-target="status" hidden>
        <span class="text-xs font-medium text-slate-600" data-course-filter-target="count" data-template="<%= t("courses.index.filter.count", visible: "%{visible}", total: "%{total}") %>"></span>
        <button type="button" class="text-xs font-semibold text-slate-900 underline underline-offset-2 cursor-pointer"
                data-action="course-filter#reset"><%= t("courses.index.filter.reset") %></button>
      </div>
    </div>
  <% end %>

  <%# ── Kategorie-Kacheln; Klick öffnet alle Kurse der Kategorie im Overlay.
      id = Anker für Links von der Startseite (öffnet das Overlay direkt). %>
  <% [ [ @restricted_courses, true ], [ @public_courses, false ] ].each do |courses, restricted| %>
    <% next if courses.empty? %>
    <% if restricted %>
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-flex items-center bg-red-100 text-red-700 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider"><%= t("courses.index.restricted_badge") %></span>
        <span class="text-sm text-slate-500"><%= t("courses.index.restricted_subtitle") %></span>
      </div>
    <% end %>
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5 mb-10">
      <% groups.call(courses).each do |category, courses_in_category| %>
        <% anchor = "#{"restricted-" if restricted}#{category.parameterize}" %>
        <% record = @category_records[category] %>
        <% days = courses_in_category.flat_map { |c| course_weekdays(c) }.uniq.sort_by { |d| (d - 1) % 7 } %>
        <div id="<%= anchor %>" data-course-filter-target="group" class="scroll-mt-28">
          <button type="button" data-action="course-filter#open" data-course-filter-dialog-param="dlg-<%= anchor %>"
                  aria-haspopup="dialog"
                  class="group flex h-full w-full flex-col overflow-hidden rounded-3xl border border-slate-200/80 bg-white text-left shadow-sm transition-[transform,box-shadow] duration-300 ease-entrance hover:-translate-y-1 hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 cursor-pointer">
            <%= render "courses/category_tile_body", category: category, courses_in_category: courses_in_category, record: record, restricted: restricted %>
          </button>

          <dialog id="dlg-<%= anchor %>" class="course-dialog" aria-labelledby="dlg-<%= anchor %>-title"
                  data-action="click->course-filter#backdropClose">
            <div class="sticky top-0 z-20 bg-white/90 backdrop-blur">
            <div class="flex items-center justify-between gap-4 border-b border-slate-200/80 px-5 py-4 sm:px-6">
              <div class="min-w-0">
                <h2 id="dlg-<%= anchor %>-title" class="truncate text-xl font-extrabold tracking-tight text-slate-900"><%= category %></h2>
                <p class="text-sm text-slate-500"><%= t("courses.index.tile.count", count: courses_in_category.size) %></p>
              </div>
              <form method="dialog">
                <button class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors cursor-pointer" aria-label="<%= t("courses.index.tile.close") %>">
                  <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
              </form>
            </div>
            <% if days.size > 1 %>
              <div class="flex items-center gap-2 overflow-x-auto border-b border-slate-200/80 px-5 py-3 [scrollbar-width:none] sm:px-6"
                   role="group" aria-label="<%= t("courses.index.filter.weekday") %>">
                <% days.each do |d| %>
                  <button type="button" class="chip" aria-pressed="false"
                          data-course-filter-target="chip" data-key="dialog-weekday" data-value="<%= d %>"
                          data-action="course-filter#toggle"><%= t("date.day_names")[d] %></button>
                <% end %>
              </div>
            <% end %>
            </div>
            <div class="space-y-3 p-4 sm:p-6">
              <% courses_in_category.each do |course| %>
                <%= render "courses/course_row", course: course, restricted: restricted %>
              <% end %>
            </div>
          </dialog>
        </div>
      <% end %>
    </div>
  <% end %>

  <div data-course-filter-target="empty" hidden class="rounded-3xl bg-white/70 p-8 text-center">
    <p class="font-bold text-slate-900"><%= t("courses.index.filter.empty") %></p>
    <button type="button" class="btn btn-primary mt-4" data-action="course-filter#reset"><%= t("courses.index.filter.reset") %></button>
  </div>

  <% if all_courses.empty? %>
    <div class="bg-white p-8 sm:p-12 rounded-3xl border border-slate-200 shadow-sm text-center">
      <h3 class="text-lg font-bold text-slate-900 mb-1"><%= t("courses.index.empty.title") %></h3>
      <p class="text-slate-500 text-sm"><%= t("courses.index.empty.subtitle") %></p>
    </div>
  <% end %>
</div>
