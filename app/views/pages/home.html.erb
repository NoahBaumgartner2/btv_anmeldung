<% content_for :title, t("pages.home.title") %>
<% content_for :full_width, true %>

<% cs = club_setting %>

<%# ══════════════════════════════════════════════════════════════════════════ %>
<%# Hero                                                                       %>
<%# ══════════════════════════════════════════════════════════════════════════ %>
<section class="text-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-20 sm:py-28 text-center">

    <% if cs.logo.attached? %>
      <%= image_tag cs.logo,
            class: "h-20 w-auto object-contain mx-auto mb-6 drop-shadow-md",
            alt: cs.club_name.presence || "Logo" %>
    <% end %>

    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
      <%= cs.club_name.presence || t("pages.home.title") %>
    </h1>
    <p class="text-white/80 text-lg sm:text-xl max-w-2xl mx-auto mb-10">
      <%= t("pages.home.hero.subtitle") %>
    </p>

    <div class="flex flex-col sm:flex-row justify-center gap-3">
      <%= link_to t("pages.home.hero.register"), new_user_registration_path,
            class: "btn bg-white text-slate-900 hover:bg-slate-100 min-h-12 px-7 text-base shadow-md" %>
      <%= link_to t("nav.login"), new_user_session_path,
            class: "btn min-h-12 px-7 text-base text-white border border-white/40 bg-white/10 hover:bg-white/20" %>
    </div>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════════════════ %>
<%# So funktioniert's                                                           %>
<%# ══════════════════════════════════════════════════════════════════════════ %>
<section class="panel rounded-3xl mx-3 sm:mx-5 mb-6 py-16 sm:py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">

    <div class="text-center mb-12">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-2"><%= t("pages.home.how_it_works.title") %></h2>
      <p class="text-gray-500"><%= t("pages.home.how_it_works.subtitle") %></p>
    </div>

    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <% (1..4).each do |n| %>
        <li class="flex flex-col rounded-3xl border border-slate-200/80 bg-white p-6 shadow-sm">
          <span class="mb-5 flex h-11 w-11 items-center justify-center rounded-2xl bg-[var(--color-secondary)] text-lg font-extrabold text-[var(--color-on-secondary)] shadow-sm" aria-hidden="true"><%= n %></span>
          <span class="mb-1 text-xs font-bold uppercase tracking-wider text-slate-500"><%= t("pages.home.how_it_works.step#{n}.label") %></span>
          <h3 class="mb-2 text-lg font-extrabold tracking-tight text-slate-900"><%= t("pages.home.how_it_works.step#{n}.title") %></h3>
          <p class="text-sm leading-relaxed text-slate-600"><%= t("pages.home.how_it_works.step#{n}.body") %></p>
        </li>
      <% end %>
    </ol>

    <div class="text-center mt-12">
      <%= link_to t("pages.home.how_it_works.cta"), new_user_registration_path,
            class: "inline-block bg-slate-900 hover:bg-slate-800 active:bg-slate-950 text-white font-bold px-8 py-3.5 rounded-full shadow-sm transition text-sm min-h-11" %>
    </div>

  </div>
</section>

<%# ══════════════════════════════════════════════════════════════════════════ %>
<%# Kursübersicht                                                               %>
<%# ══════════════════════════════════════════════════════════════════════════ %>
<section class="panel rounded-3xl mx-3 sm:mx-5 mb-6 py-16 sm:py-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-2"><%= t("pages.home.courses.title") %></h2>
      <p class="text-gray-500"><%= t("pages.home.courses.subtitle") %></p>
    </div>

    <% active_courses = @courses.select { |c| c.registration_mode == "single_session" || (c.end_date.nil? || c.end_date >= Date.today) } %>
    <% category_records = CourseCategory.with_attached_image.index_by(&:name) %>
    <% categories = active_courses.group_by(&:category_name).sort %>

    <% if categories.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <% categories.each do |category, courses_in_category| %>
          <%= link_to courses_path(anchor: category.parameterize),
                class: "group flex h-full flex-col overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-sm transition-[transform,box-shadow] duration-300 ease-entrance hover:-translate-y-1 hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900" do %>
            <%= render "courses/category_tile_body", category: category, courses_in_category: courses_in_category,
                  record: category_records[category], restricted: false %>
          <% end %>
        <% end %>
      </div>

      <div class="text-center mt-8">
        <%= link_to t("pages.home.courses.view_all"), courses_path,
              class: "inline-block text-sm font-bold text-primary-600 hover:text-primary-800 transition" %>
      </div>

    <% else %>
      <div class="text-center py-16 bg-white rounded-3xl border border-slate-200/80">
        <p class="text-gray-500"><%= t("pages.home.courses.empty") %></p>
      </div>
    <% end %>

  </div>
</section>

<%# ══════════════════════════════════════════════════════════════════════════ %>
<%# Footer                                                                      %>
<%# ══════════════════════════════════════════════════════════════════════════ %>
<footer class="text-white/70 py-10">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
    <% if cs.logo.attached? %>
      <%= image_tag cs.logo, class: "h-10 w-auto object-contain mx-auto mb-3 opacity-80", alt: cs.club_name.presence || "Logo" %>
    <% end %>
    <p class="font-bold text-white text-sm mb-1"><%= cs.club_name.presence || t("pages.home.footer.portal") %></p>
    <p class="text-xs mb-4"><%= t("pages.home.footer.tagline") %></p>
    <div class="flex justify-center gap-6 text-xs">
      <%= link_to t("nav.courses"), courses_path, class: "hover:text-white transition" %>
      <%= link_to t("nav.login"), new_user_session_path, class: "hover:text-white transition" %>
      <%= link_to t("nav.register"), new_user_registration_path, class: "hover:text-white transition" %>
    </div>
  </div>
</footer>
