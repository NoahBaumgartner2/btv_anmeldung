<% unless cookies[:cookie_consent].present? %>
<div data-controller="cookie-consent"
     data-cookie-consent-url-value="<%= cookie_consent_path %>"
     class="fixed inset-x-3 bottom-24 lg:bottom-4 lg:left-[17.75rem] lg:right-4 z-50 p-4 sm:p-5 glass-strong rounded-2xl">
  <div class="container mx-auto max-w-4xl flex flex-col sm:flex-row items-start sm:items-center gap-4">
    <div class="flex-1 text-sm text-slate-700 leading-relaxed">
      <p>
        <%= t("cookie_consent.message") %>
        <%= link_to t("layouts.footer.privacy"), privacy_path, class: "text-primary-600 underline hover:text-primary-800 whitespace-nowrap" %>
      </p>
    </div>
    <div class="flex flex-col sm:flex-row gap-2 shrink-0">
      <button type="button"
              data-action="click->cookie-consent#acceptNecessary"
              class="btn btn-secondary">
        <%= t("cookie_consent.accept_necessary") %>
      </button>
      <button type="button"
              data-action="click->cookie-consent#acceptAll"
              class="btn btn-primary">
        <%= t("cookie_consent.accept_all") %>
      </button>
    </div>
  </div>
</div>
<% end %>
