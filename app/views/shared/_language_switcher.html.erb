<div class="inline-flex items-center gap-0.5 bg-slate-900/5 rounded-full p-0.5">
  <% [[:de, "DE"], [:fr, "FR"], [:en, "EN"]].each do |loc, label| %>
    <% active = I18n.locale == loc %>
    <%= button_to label, locale_path, method: :post,
          params: { locale: loc },
          class: "text-xs font-semibold px-2.5 py-1 rounded-full transition-colors cursor-pointer " +
                 (active ? "bg-white text-slate-900 shadow-sm" : "text-slate-600 hover:text-slate-900") %>
  <% end %>
</div>
