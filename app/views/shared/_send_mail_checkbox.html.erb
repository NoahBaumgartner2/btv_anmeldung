<%# Auswahl, ob die Aktion eine E-Mail auslöst (Standard: senden, siehe ApplicationController#send_mail?).
    Das Hidden-Feld meldet die Abwahl. form_id: nur für eine Box ausserhalb ihres Formulars. %>
<% form_id = local_assigns[:form_id] %>
<label class="flex items-center gap-2 text-sm font-medium text-gray-700 cursor-pointer">
  <%= hidden_field_tag :send_mail, "0", id: nil, form: form_id %>
  <%= check_box_tag :send_mail, "1", send_mail?, id: nil, form: form_id,
        class: "h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 cursor-pointer" %>
  <span><%= text %></span>
</label>
